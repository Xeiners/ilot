<UserControl
    x:Class="Ilot.Controls.NotchSearchBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls"
    Width="124"
    Height="26">

    <!--
        Just a magnifier until clicked, then a field that grows to the left (its pill is drawn and stretched by the
        compositor). The host places it, usually at the right end of the tab bar row.
    -->
    <Grid>
        <Grid x:Name="SearchPill" IsHitTestVisible="False" />

        <Grid
            x:Name="SearchInput"
            Margin="12,0,28,0"
            ColumnSpacing="4"
            IsHitTestVisible="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="SearchHint"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Text"
                FontSize="12"
                Foreground="{StaticResource NotchSecondaryTextBrush}"
                IsHitTestVisible="False"
                Text="Rechercher" />
            <TextBox
                x:Name="SearchBox"
                VerticalAlignment="Center"
                GotFocus="OnSearchGotFocus"
                KeyDown="OnSearchKeyDown"
                PreviewKeyDown="OnSearchPreviewKeyDown"
                LostFocus="OnSearchLostFocus"
                Style="{StaticResource NotchFieldTextBoxStyle}"
                TextChanged="OnSearchTextChanged" />
            <controls:MotionButton
                x:Name="SearchClear"
                Grid.Column="1"
                Width="16"
                Height="16"
                AutomationProperties.Name="Effacer la recherche"
                Click="OnSearchClearClick"
                Visibility="Collapsed">
                <FontIcon FontSize="8" Glyph="&#xE711;" />
            </controls:MotionButton>
        </Grid>

        <controls:MotionButton
            x:Name="SearchButton"
            Width="26"
            Height="26"
            HorizontalAlignment="Right"
            Click="OnSearchButtonClick"
            ToolTipService.ToolTip="Rechercher">
            <FontIcon FontSize="13" Glyph="&#xE721;" />
        </controls:MotionButton>
    </Grid>
</UserControl>
