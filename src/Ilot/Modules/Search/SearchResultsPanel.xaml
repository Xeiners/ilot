<UserControl
    x:Class="Ilot.Modules.Search.SearchResultsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <UserControl.Resources>
        <!--  A key, the way the keyboard prints it.  -->
        <Style x:Key="SearchKeyCapStyle" TargetType="Border">
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#1FFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SearchKeyTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#B3FFFFFF" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SearchHintTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#66FFFFFF" />
            <Setter Property="Margin" Value="5,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid>
            <!--
                The lines: as many show as the settings say, the rest scroll (wheel, arrows, Page ↑ / Page ↓). The
                scroller's own bar is hidden: a slim one of the notch's own shows where one is (see SearchResultsPanel).
            -->
            <ScrollViewer
                x:Name="Scroller"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Hidden"
                VerticalScrollMode="Enabled"
                ZoomMode="Disabled">
                <Grid Margin="8,8,8,4" VerticalAlignment="Top">
                    <!--  The chosen line: glides from line to line on a spring (see SearchResultsPanel).  -->
                    <Border
                        x:Name="Highlight"
                        Height="50"
                        VerticalAlignment="Top"
                        Background="#1CFFFFFF"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        CornerRadius="14"
                        IsHitTestVisible="False" />
                    <StackPanel x:Name="Rows" VerticalAlignment="Top" />
                </Grid>
            </ScrollViewer>

            <!--  More above, more below: the lines melt into the drop's black at that edge.  -->
            <Rectangle
                x:Name="TopFade"
                Height="18"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle
                x:Name="BottomFade"
                Height="18"
                VerticalAlignment="Bottom"
                IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#FF000000" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!--  Where one is in the list: a slim bar at the right edge, only when there is more than shows.  -->
            <Border
                x:Name="Thumb"
                Width="3"
                Margin="0,10,3,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#40FFFFFF"
                CornerRadius="1.5"
                IsHitTestVisible="False" />

            <TextBlock
                x:Name="NoResults"
                Margin="28,8,28,4"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Text"
                FontSize="13"
                Foreground="#80FFFFFF"
                TextTrimming="CharacterEllipsis"
                Visibility="Collapsed" />
        </Grid>

        <!--  What the keys do, and who finds the files.  -->
        <Grid Grid.Row="1" Padding="18,0,12,4">
            <Rectangle
                Height="1"
                Margin="-18,0,-12,0"
                VerticalAlignment="Top"
                Fill="#14FFFFFF" />
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Border Style="{StaticResource SearchKeyCapStyle}">
                    <TextBlock Style="{StaticResource SearchKeyTextStyle}" Text="↑↓" />
                </Border>
                <TextBlock Style="{StaticResource SearchHintTextStyle}" Text="choisir" />
                <Border Style="{StaticResource SearchKeyCapStyle}">
                    <FontIcon FontSize="10" Foreground="#B3FFFFFF" Glyph="&#xE751;" />
                </Border>
                <TextBlock Style="{StaticResource SearchHintTextStyle}" Text="ouvrir" />
                <Border Style="{StaticResource SearchKeyCapStyle}">
                    <TextBlock Style="{StaticResource SearchKeyTextStyle}" Text="Ctrl ↵" />
                </Border>
                <TextBlock Style="{StaticResource SearchHintTextStyle}" Text="dossier" />
                <Border Style="{StaticResource SearchKeyCapStyle}">
                    <TextBlock Style="{StaticResource SearchKeyTextStyle}" Text="Ctrl C" />
                </Border>
                <TextBlock Style="{StaticResource SearchHintTextStyle}" Text="copier le chemin" />
            </StackPanel>

            <!--  Credit where it is due.  -->
            <HyperlinkButton
                x:Name="EverythingCredit"
                Padding="6,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="OnEverythingClick"
                ToolTipService.ToolTip="Everything, de voidtools : la recherche de fichiers instantanée">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon
                        x:Name="EverythingGlyph"
                        FontSize="11"
                        Foreground="#FFFFC857"
                        Glyph="&#xE945;" />
                    <TextBlock
                        x:Name="EverythingText"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="11"
                        Foreground="#80FFFFFF"
                        Text="Boosté par Everything" />
                </StackPanel>
            </HyperlinkButton>
        </Grid>
    </Grid>
</UserControl>
