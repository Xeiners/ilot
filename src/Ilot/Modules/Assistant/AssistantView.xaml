<UserControl
    x:Class="Ilot.Modules.Assistant.AssistantView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--  The question: big and plain, the text itself is the field; several lines (Shift + Enter), scrolling past four.  -->
        <Style
            x:Key="QuestionStyle"
            BasedOn="{StaticResource NotchFieldTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="SelectionHighlightColor" Value="#FF5A4FCF" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="104" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer
                            x:Name="ContentElement"
                            AutomationProperties.AccessibilityView="Raw"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="Hidden"
                            VerticalScrollMode="Enabled"
                            ZoomMode="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--  The open notch is a bar to ask the mascot in (it waits in the drop under it, see AssistantPanel); taller with  -->
    <!--  each line of the question, and with the images pasted, shown under it.  -->
    <Grid
        x:Name="LayoutRoot"
        MinHeight="60"
        Padding="24,17,18,17"
        VerticalAlignment="Top"
        ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <FontIcon
            x:Name="AskGlyph"
            Width="20"
            Height="20"
            Margin="0,3,0,0"
            VerticalAlignment="Top"
            FontSize="18"
            Foreground="#8CFFFFFF"
            Glyph="&#xE8BD;" />

        <Grid Grid.Column="1" VerticalAlignment="Top">
            <TextBlock
                x:Name="Hint"
                VerticalAlignment="Top"
                FontFamily="Segoe UI Variable Display"
                FontSize="19"
                Foreground="#52FFFFFF"
                IsHitTestVisible="False"
                Text="Demandez-moi quelque chose…"
                TextTrimming="CharacterEllipsis" />
            <TextBox
                x:Name="QuestionBox"
                AutomationProperties.Name="Question pour l'assistant"
                Style="{StaticResource QuestionStyle}" />
        </Grid>

        <StackPanel
            Grid.Column="2"
            Margin="0,-1,0,0"
            VerticalAlignment="Top"
            Orientation="Horizontal"
            Spacing="10">
            <!--  Talking: how loud its voice is (the mascot's colour; the wheel on the mascot too, see SetVoiceVolume).  -->
            <StackPanel
                x:Name="VoiceVolume"
                Margin="0,4,0,0"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="7"
                Visibility="Collapsed">
                <FontIcon
                    x:Name="VoiceVolumeGlyph"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="#B3FFFFFF"
                    Glyph="&#xE767;" />
                <Border
                    x:Name="VoiceVolumeHost"
                    Width="84"
                    VerticalAlignment="Center" />
            </StackPanel>
            <Border
                Height="22"
                Margin="0,3,0,0"
                Padding="8,0"
                VerticalAlignment="Top"
                Background="#1AFFFFFF"
                CornerRadius="7">
                <TextBlock
                    x:Name="KeyText"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="11"
                    Foreground="#80FFFFFF"
                    Text="Échap" />
            </Border>
        </StackPanel>

        <StackPanel
            x:Name="Attachments"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,10,0,0"
            Orientation="Horizontal"
            Spacing="8"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
