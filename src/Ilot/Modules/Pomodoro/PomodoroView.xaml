<UserControl
    x:Class="Ilot.Modules.Pomodoro.PomodoroView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!--  A round button of the controls: quiet, lighter under the pointer.  -->
        <Style x:Key="PomodoroRoundStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
        </Style>
    </UserControl.Resources>

    <!--
        The Pomodoro: the ring of the phase on the left (its colour, emptying as the time goes, the time left in it), what
        the phase is in the middle (its name, the sessions as dots, today's focus), and the controls on the right. Vertical
        position from the tab bar in code.
    -->
    <Grid
        x:Name="LayoutRoot"
        Height="112"
        Padding="26,0,26,0"
        VerticalAlignment="Top"
        ColumnSpacing="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  The ring, drawn on the compositor (see CreateRing), the time in it.  -->
        <Grid
            x:Name="Dial"
            Width="104"
            Height="104"
            VerticalAlignment="Center">
            <Border x:Name="RingHost" IsHitTestVisible="False" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="0">
                <TextBlock
                    x:Name="TimeText"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="25"
                    FontWeight="SemiBold"
                    Foreground="#F5FFFFFF"
                    Text="25:00"
                    Typography.NumeralAlignment="Tabular" />
                <TextBlock
                    x:Name="StateText"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="10.5"
                    Foreground="#8FFFFFFF"
                    Text="Prêt" />
            </StackPanel>
        </Grid>

        <!--  What the phase is.  -->
        <StackPanel
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="6">
            <TextBlock
                x:Name="PhaseText"
                FontFamily="Segoe UI Variable Display"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#F5FFFFFF"
                Text="Focus" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel
                    x:Name="Dots"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="5" />
                <TextBlock
                    x:Name="SessionText"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12"
                    Foreground="#A6FFFFFF" />
                <!--  The whole series over (shown once it has begun): a focus, session 1, not running.  -->
                <Button
                    x:Name="NewSeriesButton"
                    Height="22"
                    Padding="9,0,10,0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Nouvelle série"
                    Background="#1AFFFFFF"
                    BorderThickness="0"
                    CornerRadius="11"
                    Foreground="#CCFFFFFF"
                    ToolTipService.ToolTip="Tout arrêter et repartir de la session 1"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <FontIcon FontSize="10" Glyph="&#xE8EE;" />
                        <TextBlock
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11"
                            Text="Nouvelle série" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="TodayText"
                FontFamily="Segoe UI Variable Text"
                FontSize="11.5"
                Foreground="#80FFFFFF"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!--  Its settings (a drop under the notch), again, start / pause, next.  -->
        <StackPanel
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="SettingsButton"
                Width="32"
                Height="32"
                CornerRadius="16"
                AutomationProperties.Name="Réglages du Pomodoro"
                Background="Transparent"
                Style="{StaticResource PomodoroRoundStyle}"
                ToolTipService.ToolTip="Réglages du Pomodoro">
                <FontIcon FontSize="13" Glyph="&#xE713;" />
            </Button>
            <Button
                x:Name="RestartButton"
                AutomationProperties.Name="Recommencer cette phase"
                Style="{StaticResource PomodoroRoundStyle}"
                ToolTipService.ToolTip="Recommencer cette phase">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                x:Name="PlayButton"
                Width="58"
                Height="58"
                AutomationProperties.Name="Démarrer"
                CornerRadius="29"
                Foreground="#F0101012"
                Style="{StaticResource PomodoroRoundStyle}">
                <FontIcon
                    x:Name="PlayGlyph"
                    FontSize="20"
                    Glyph="&#xE768;" />
            </Button>
            <Button
                x:Name="SkipButton"
                AutomationProperties.Name="Passer à la suite"
                Style="{StaticResource PomodoroRoundStyle}"
                ToolTipService.ToolTip="Passer à la suite">
                <FontIcon FontSize="14" Glyph="&#xE893;" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
