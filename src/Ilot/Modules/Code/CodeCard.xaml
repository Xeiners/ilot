<UserControl
    x:Class="Ilot.Modules.Code.CodeCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls"
    Width="190"
    Height="96">

    <!--
        A recent project, in the colour of what it is made with: its name, where it is, a badge for its stack;
        clicking the tile opens it in VS Code. Bottom right, always at hand:
        show it in the Explorer, copy its path.
    -->
    <Grid x:Name="CardRoot">
        <controls:MotionButton
            x:Name="Body"
            Click="OnBodyClick"
            HaloOpacity="0.06"
            HaloRestScale="1"
            HoverScale="0.03"
            PressScale="0.05"
            Style="{StaticResource NotchCardButtonStyle}">
            <Grid x:Name="Face">
                <!--  Glass: a sheen of light across the top, as on a pane catching it (painted in code).  -->
                <Border x:Name="Sheen" CornerRadius="16" IsHitTestVisible="False" />

                <StackPanel Margin="12,10,12,0" VerticalAlignment="Top">
                    <Grid ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="KindIcon"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="{StaticResource NotchSecondaryTextBrush}" />
                        <TextBlock
                            x:Name="NameText"
                            Grid.Column="1"
                            Style="{StaticResource NotchTitleTextStyle}"
                            FontSize="13" />
                    </Grid>
                    <TextBlock
                        x:Name="PlaceText"
                        Margin="0,3,0,0"
                        Style="{StaticResource NotchSubtitleTextStyle}"
                        FontSize="11"
                        MaxLines="2"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  Bottom left: what it is made with, in its colour.  -->
                <Border
                    x:Name="Badge"
                    Height="20"
                    Margin="12,0,0,14"
                    Padding="8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    CornerRadius="10">
                    <TextBlock
                        x:Name="BadgeText"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="10.5"
                        FontWeight="SemiBold" />
                </Border>

                <!--  Glass edge: a hairline, bright where the light comes from (painted in code).  -->
                <Border
                    x:Name="Rim"
                    BorderThickness="1"
                    CornerRadius="16"
                    IsHitTestVisible="False" />

                <!--  Chosen with the arrow keys while searching: a bright ring.  -->
                <Border
                    x:Name="SelectionRing"
                    BorderBrush="#E6FFFFFF"
                    BorderThickness="2"
                    CornerRadius="16"
                    IsHitTestVisible="False" />
            </Grid>
        </controls:MotionButton>

        <!--  Actions, always visible: a small toolbar at the bottom right.  -->
        <Border
            Margin="0,0,8,10"
            Padding="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#1AFFFFFF"
            CornerRadius="15">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <controls:MotionButton
                    x:Name="RevealAction"
                    Width="28"
                    Height="28"
                    AutomationProperties.Name="Ouvrir l'emplacement"
                    Click="OnRevealClick"
                    ToolTipService.ToolTip="Ouvrir l'emplacement">
                    <FontIcon FontSize="13" Glyph="&#xE838;" />
                </controls:MotionButton>
                <controls:MotionButton
                    Width="28"
                    Height="28"
                    AutomationProperties.Name="Copier le chemin"
                    Click="OnCopyClick"
                    ToolTipService.ToolTip="Copier le chemin">
                    <FontIcon FontSize="13" Glyph="&#xE8C8;" />
                </controls:MotionButton>
            </StackPanel>
        </Border>

        <!--  Confirmation once VS Code is on its way.  -->
        <Border
            x:Name="Confirmation"
            Background="#F2161618"
            CornerRadius="16"
            IsHitTestVisible="False">
            <StackPanel
                x:Name="ConfirmationContent"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="5">
                <FontIcon FontSize="18" Foreground="{StaticResource NotchPrimaryTextBrush}" Glyph="&#xE943;" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource NotchPrimaryTextBrush}"
                    Text="Ouverture dans VS Code" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
