<UserControl
    x:Class="Ilot.Modules.Notes.NoteCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls"
    Width="150"
    Height="96">

    <!--  A note in the row: its title, its first lines, when it changed. The open one is ringed.  -->
    <Grid>
        <controls:MotionButton
            x:Name="Body"
            Click="OnBodyClick"
            HaloOpacity="0.06"
            HaloRestScale="1"
            HoverScale="0.03"
            PressScale="0.05"
            Style="{StaticResource NotchCardButtonStyle}">
            <Grid Margin="12,10,12,10" RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon
                        FontSize="10"
                        Foreground="#FFFFC857"
                        Glyph="&#xE70B;" />
                    <TextBlock
                        x:Name="WhenText"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="10.5"
                        Foreground="{StaticResource NotchSecondaryTextBrush}" />
                </StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="1"
                    Margin="0,3,0,0"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource NotchPrimaryTextBrush}"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="PreviewText"
                    Grid.Row="2"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="11"
                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                    LineHeight="14"
                    LineStackingStrategy="BlockLineHeight"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
            </Grid>
        </controls:MotionButton>

        <!--  The note open in the sheet.  -->
        <Border
            x:Name="Ring"
            BorderBrush="#99FFC857"
            BorderThickness="1.5"
            CornerRadius="16"
            IsHitTestVisible="False"
            Opacity="0" />
    </Grid>
</UserControl>
