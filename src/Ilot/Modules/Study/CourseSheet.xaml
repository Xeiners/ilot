<UserControl
    x:Class="Ilot.Modules.Study.CourseSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls"
    xmlns:mascot="using:Ilot.Mascot"
    RequestedTheme="Dark">

    <!--
        A course open: its title and numbers, its modes (Réviser, Fiche, Cartes), new cards on demand, and what the mode
        shows (or Notch at work on it). In the bubble under the notch, or in a window of its own (see DetachedWindow).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Two soft glows in the mascot's colour (see TintGlows), in the sheet's top left and bottom right corners,
            away from the text: the black is not flat, the reading stays clear. Still.
        -->
        <Grid
            Grid.RowSpan="4"
            IsHitTestVisible="False">
            <Rectangle x:Name="GlowTop" />
            <Rectangle x:Name="GlowBottom" />
        </Grid>

        <!--  ── The course, and its actions ──  -->
        <Grid
            x:Name="Header"
            Margin="24,16,14,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  The title and the numbers.  -->
            <Grid>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        x:Name="SheetTitle"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchPrimaryTextBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <StackPanel
                        x:Name="SheetStats"
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="6" />
                </StackPanel>
            </Grid>

            <!--  Its actions; in a window, the window's own among them (see AddWindowTools).  -->
            <StackPanel
                x:Name="Actions"
                Grid.Column="1"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="8">
                <!--  Deleting asks once: the pill turns red, a second click confirms.  -->
                <controls:MotionButton
                    x:Name="DeleteButton"
                    AutomationProperties.Name="Supprimer le cours"
                    Click="OnDeleteClick"
                    Style="{StaticResource StudyPillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock x:Name="DeleteText" Text="Supprimer" />
                    </StackPanel>
                </controls:MotionButton>

                <!--  The sheet out of the notch into a window of its own (see DetachedWindow), or back.  -->
                <controls:MotionButton
                    x:Name="MoveButton"
                    Width="28"
                    MinWidth="0"
                    Padding="0"
                    Click="OnMoveClick"
                    Style="{StaticResource NotchPillButtonStyle}">
                    <FontIcon
                        x:Name="MoveIcon"
                        FontSize="11"
                        Glyph="&#xE8A7;" />
                </controls:MotionButton>

                <controls:MotionButton
                    x:Name="CloseButton"
                    Width="28"
                    MinWidth="0"
                    Padding="0"
                    AutomationProperties.Name="Fermer"
                    Click="OnCloseClick"
                    Style="{StaticResource NotchPillButtonStyle}"
                    ToolTipService.ToolTip="Fermer">
                    <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                </controls:MotionButton>
            </StackPanel>
        </Grid>

        <!--  ── Its modes, and more cards ──  -->
        <Grid
            x:Name="ModeBar"
            Grid.Row="1"
            Margin="16,12,16,0">
            <Border
                Padding="4"
                HorizontalAlignment="Left"
                Background="#0DFFFFFF"
                BorderBrush="#12FFFFFF"
                BorderThickness="1"
                CornerRadius="19">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <controls:MotionButton
                        x:Name="ReviewMode"
                        Click="OnModeClick"
                        Style="{StaticResource StudyChoiceStyle}"
                        Tag="Review">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE7BE;" />
                            <TextBlock Text="Réviser" />
                        </StackPanel>
                    </controls:MotionButton>
                    <controls:MotionButton
                        x:Name="SummaryMode"
                        Click="OnModeClick"
                        Style="{StaticResource StudyChoiceStyle}"
                        Tag="Summary">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                            <TextBlock Text="Fiche" />
                        </StackPanel>
                    </controls:MotionButton>
                    <controls:MotionButton
                        x:Name="CardsMode"
                        Click="OnModeClick"
                        Style="{StaticResource StudyChoiceStyle}"
                        Tag="Cards">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                            <TextBlock x:Name="CardsModeText" Text="Cartes" />
                        </StackPanel>
                    </controls:MotionButton>
                    <controls:MotionButton
                        x:Name="MapsMode"
                        Click="OnModeClick"
                        Style="{StaticResource StudyChoiceStyle}"
                        Tag="Maps">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xF22C;" />
                            <TextBlock Text="Cartes mentales" />
                        </StackPanel>
                    </controls:MotionButton>
                </StackPanel>
            </Border>

            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
            <!--  The revisions' sounds: hovered, their volume opens beside; a click mutes them.  -->
            <StackPanel
                x:Name="SoundControl"
                Background="Transparent"
                Orientation="Horizontal"
                PointerEntered="OnSoundEntered"
                PointerExited="OnSoundExited"
                Spacing="6">
                <Border
                    x:Name="VolumePill"
                    Height="32"
                    Padding="14,0,12,0"
                    Background="#14FFFFFF"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="1"
                    CornerRadius="16"
                    Visibility="Collapsed">
                    <Slider
                        x:Name="VolumeSlider"
                        Width="110"
                        VerticalAlignment="Center"
                        IsThumbToolTipEnabled="False"
                        Maximum="100"
                        Minimum="0"
                        StepFrequency="5"
                        ValueChanged="OnVolumeChanged" />
                </Border>
                <controls:MotionButton
                    x:Name="SoundButton"
                    Width="32"
                    MinWidth="0"
                    Padding="0"
                    Background="#14FFFFFF"
                    Click="OnSoundClick"
                    Style="{StaticResource NotchPillButtonStyle}">
                    <FontIcon x:Name="SoundIcon" FontSize="12" />
                </controls:MotionButton>
            </StackPanel>
            <controls:MotionButton
                x:Name="MoreButton"
                Background="#F2FFFFFF"
                Click="OnMoreClick"
                Foreground="#FF111114"
                HaloOpacity="0.1"
                HaloRestScale="1"
                HoverScale="0.04"
                PressScale="0.06"
                Style="{StaticResource StudyPillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                    <TextBlock Text="Nouvelles cartes" />
                </StackPanel>
            </controls:MotionButton>
            </StackPanel>
        </Grid>

        <!--  ── New cards: on what, how many ──  -->
        <Border
            x:Name="MoreStrip"
            Grid.Row="2"
            Margin="16,10,16,0"
            Padding="14,10,14,12"
            Background="#0DFFFFFF"
            BorderBrush="#12FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="Collapsed">
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource NotchSubtitleTextStyle}"
                    Text="Sur" />
                <ScrollViewer
                    x:Name="FocusScroller"
                    Grid.Column="1"
                    HorizontalScrollBarVisibility="Hidden"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled">
                    <StackPanel x:Name="FocusChoices" Orientation="Horizontal" Spacing="4" />
                </ScrollViewer>
                <TextBlock
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Style="{StaticResource NotchSubtitleTextStyle}"
                    Text="Combien" />
                <Grid
                    Grid.Row="1"
                    Grid.Column="1"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="CountChoices" Orientation="Horizontal" Spacing="4" />
                    <TextBlock
                        x:Name="MoreStatus"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="12"
                        Foreground="{StaticResource NotchSecondaryTextBrush}"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <controls:MotionButton
                        x:Name="GenerateButton"
                        Grid.Column="2"
                        Background="#F2FFFFFF"
                        Click="OnGenerateClick"
                        Foreground="#FF111114"
                        HaloOpacity="0.1"
                        HaloRestScale="1"
                        HoverScale="0.04"
                        PressScale="0.06"
                        Style="{StaticResource StudyPillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE945;" />
                            <TextBlock Text="Générer" />
                        </StackPanel>
                    </controls:MotionButton>
                </Grid>
            </Grid>
        </Border>

        <!--  ── What the mode shows ──  -->
        <Grid x:Name="SheetContent" Grid.Row="3">

            <!--
                Notch at work on the course (the mascot reads it), its steps filling as they go; or what went wrong.
            -->
            <StackPanel
                x:Name="BusyPanel"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="16"
                Visibility="Collapsed">
                <mascot:MascotView
                    x:Name="Reader"
                    Width="92"
                    Height="92"
                    HorizontalAlignment="Center"
                    IsHitTestVisible="False" />
                <StackPanel Spacing="4">
                    <TextBlock
                        x:Name="BusyTitle"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchPrimaryTextBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="BusyText"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="12.5"
                        Foreground="{StaticResource NotchSecondaryTextBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border
                    Padding="18,14,18,16"
                    Background="#0DFFFFFF"
                    BorderBrush="#12FFFFFF"
                    BorderThickness="1"
                    CornerRadius="18">
                    <StackPanel Spacing="14">
                    <Grid ColumnSpacing="12" RowSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon
                            x:Name="OutlineIcon"
                            VerticalAlignment="Center"
                            FontSize="13" />
                        <TextBlock
                            x:Name="OutlineLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Le plan du cours" />
                        <TextBlock
                            x:Name="OutlineDetail"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="12"
                            Foreground="{StaticResource NotchSecondaryTextBrush}"
                            Typography.NumeralAlignment="Tabular" />
                        <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Height="4">
                            <Border Background="{StaticResource NotchTrackBrush}" CornerRadius="2" />
                            <Border
                                x:Name="OutlineFill"
                                Background="{StaticResource NotchTrackFillBrush}"
                                CornerRadius="2" />
                        </Grid>
                        <TextBlock
                            x:Name="OutlineNote"
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11.5"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>
                    <Grid ColumnSpacing="12" RowSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon
                            x:Name="SummaryIcon"
                            VerticalAlignment="Center"
                            FontSize="13" />
                        <TextBlock
                            x:Name="SummaryLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="La fiche de révision" />
                        <TextBlock
                            x:Name="SummaryDetail"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="12"
                            Foreground="{StaticResource NotchSecondaryTextBrush}"
                            Typography.NumeralAlignment="Tabular" />
                        <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Height="4">
                            <Border Background="{StaticResource NotchTrackBrush}" CornerRadius="2" />
                            <Border
                                x:Name="SummaryFill"
                                Background="{StaticResource NotchTrackFillBrush}"
                                CornerRadius="2" />
                        </Grid>
                        <TextBlock
                            x:Name="SummaryNote"
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11.5"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>
                    <Grid ColumnSpacing="12" RowSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <FontIcon
                            x:Name="CardsIcon"
                            VerticalAlignment="Center"
                            FontSize="13" />
                        <TextBlock
                            x:Name="CardsLabel"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Les flashcards" />
                        <TextBlock
                            x:Name="CardsDetail"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="12"
                            Foreground="{StaticResource NotchSecondaryTextBrush}"
                            Typography.NumeralAlignment="Tabular" />
                        <Grid
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Height="4">
                            <Border Background="{StaticResource NotchTrackBrush}" CornerRadius="2" />
                            <Border
                                x:Name="CardsFill"
                                Background="{StaticResource NotchTrackFillBrush}"
                                CornerRadius="2" />
                        </Grid>
                        <TextBlock
                            x:Name="CardsNote"
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11.5"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </Grid>
                    </StackPanel>
                </Border>
                <TextBlock
                    x:Name="BusyHint"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12"
                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                    Text="Vous pouvez fermer la notch : Notch vous prévient quand c'est prêt."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <controls:MotionButton
                    x:Name="RetryButton"
                    HorizontalAlignment="Center"
                    Click="OnRetryClick"
                    Style="{StaticResource StudyPillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                        <TextBlock Text="Réessayer" />
                    </StackPanel>
                </controls:MotionButton>
            </StackPanel>

            <!--  Revision: a ReviewView (the card, its choices, its answer, how well it came), set in code.  -->
            <ContentControl
                x:Name="ReviewPanel"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                IsTabStop="False"
                Visibility="Collapsed" />

            <!--  The summary sheet.  -->
            <Grid x:Name="SummaryPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="20,10,20,6" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel x:Name="SheetParts" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>
                    <controls:MotionButton
                        x:Name="CopySummaryButton"
                        Grid.Column="1"
                        Click="OnCopySummaryClick"
                        Style="{StaticResource StudyPillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                x:Name="CopySummaryIcon"
                                FontSize="12"
                                Glyph="&#xE8C8;" />
                            <TextBlock x:Name="CopySummaryText" Text="Copier" />
                        </StackPanel>
                    </controls:MotionButton>
                </Grid>
                <ScrollViewer
                    x:Name="SummaryScroller"
                    Grid.Row="1"
                    Padding="20,6,20,24"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Border x:Name="SheetHost" HorizontalAlignment="Center" />
                </ScrollViewer>
            </Grid>

            <!--  The cards: each one read, edited, removed.  -->
            <ScrollViewer
                x:Name="CardsPanel"
                Padding="20,10,20,20"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                Visibility="Collapsed">
                <StackPanel x:Name="CardsList" Spacing="8" />
            </ScrollViewer>

            <!--  The mind maps: the course at a glance, a map per important notion, part by part.  -->
            <Grid x:Name="MapsPanel" Visibility="Collapsed">

                <!--  None yet (or Notch drawing the first ones): what they are, and « Générer les cartes mentales ».  -->
                <StackPanel
                    x:Name="MapsEmpty"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
                    <FontIcon
                        x:Name="MapsIcon"
                        HorizontalAlignment="Center"
                        FontSize="34"
                        Glyph="&#xF22C;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchPrimaryTextBrush}"
                        Text="Le cours d'un coup d'œil"
                        TextAlignment="Center" />
                    <TextBlock
                        FontFamily="Segoe UI Variable Text"
                        FontSize="12.5"
                        Foreground="{StaticResource NotchSecondaryTextBrush}"
                        Text="Une carte mentale par notion importante, partie par partie, et une vue d'ensemble du cours : l'essentiel, en quelques mots."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <controls:MotionButton
                        x:Name="DrawButton"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        Background="#F2FFFFFF"
                        Click="OnDrawClick"
                        Foreground="#FF111114"
                        HaloOpacity="0.1"
                        HaloRestScale="1"
                        HoverScale="0.04"
                        PressScale="0.06"
                        Style="{StaticResource StudyPillStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xF22C;" />
                            <TextBlock Text="Générer les cartes mentales" />
                        </StackPanel>
                    </controls:MotionButton>
                    <TextBlock
                        x:Name="MapsStatus"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="12"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                    <!--  While Notch draws them: the parts gone through.  -->
                    <Grid
                        x:Name="MapsBar"
                        Width="260"
                        Height="4"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                        <Border Background="{StaticResource NotchTrackBrush}" CornerRadius="2" />
                        <Border
                            x:Name="MapsFill"
                            Background="{StaticResource NotchTrackFillBrush}"
                            CornerRadius="2" />
                    </Grid>
                </StackPanel>

                <!--  Drawn: the notions, part by part, on the left; the map chosen on the right.  -->
                <Grid
                    x:Name="MapsBrowser"
                    Padding="16,10,16,16"
                    ColumnSpacing="14"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="224" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="MapsList"
                            Padding="0,0,10,8"
                            Spacing="2" />
                    </ScrollViewer>
                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                <TextBlock
                                    x:Name="MapPart"
                                    FontFamily="Segoe UI Variable Text"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                                    MaxLines="1"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="MapCount"
                                    FontFamily="Segoe UI Variable Text"
                                    FontSize="11"
                                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                                    Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    x:Name="MapsWorking"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI Variable Text"
                                    FontSize="12"
                                    MaxWidth="260"
                                    MaxLines="2"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <controls:MotionButton
                                    x:Name="PreviousMapButton"
                                    Width="28"
                                    MinWidth="0"
                                    Padding="0"
                                    AutomationProperties.Name="Carte précédente"
                                    Click="OnPreviousMapClick"
                                    Style="{StaticResource NotchPillButtonStyle}"
                                    ToolTipService.ToolTip="Carte précédente">
                                    <FontIcon FontSize="10" Glyph="&#xE76B;" />
                                </controls:MotionButton>
                                <controls:MotionButton
                                    x:Name="NextMapButton"
                                    Width="28"
                                    MinWidth="0"
                                    Padding="0"
                                    AutomationProperties.Name="Carte suivante"
                                    Click="OnNextMapClick"
                                    Style="{StaticResource NotchPillButtonStyle}"
                                    ToolTipService.ToolTip="Carte suivante">
                                    <FontIcon FontSize="10" Glyph="&#xE76C;" />
                                </controls:MotionButton>
                                <controls:MotionButton
                                    x:Name="RedrawButton"
                                    Click="OnDrawClick"
                                    Style="{StaticResource StudyPillStyle}"
                                    ToolTipService.ToolTip="Notch refait toutes les cartes mentales du cours">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                                        <TextBlock Text="Redessiner" />
                                    </StackPanel>
                                </controls:MotionButton>
                            </StackPanel>
                        </Grid>
                        <Border
                            x:Name="MapHost"
                            Grid.Row="1"
                            Padding="16"
                            Background="#08FFFFFF"
                            BorderBrush="#10FFFFFF"
                            BorderThickness="1"
                            CornerRadius="20" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
