<UserControl
    x:Class="Ilot.Modules.Study.DeckTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls"
    Width="184"
    Height="96">

    <!--  A course in the row: what is due, its title, how many cards and how well they are known. The open one is ringed.  -->
    <Grid>
        <controls:MotionButton
            x:Name="Body"
            Click="OnBodyClick"
            HaloOpacity="0.06"
            HaloRestScale="1"
            HoverScale="0.03"
            PressScale="0.05"
            Style="{StaticResource NotchCardButtonStyle}">
            <Grid Margin="12,10,12,10" RowSpacing="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <FontIcon
                        x:Name="StateIcon"
                        FontSize="10"
                        Glyph="&#xE7BE;" />
                    <TextBlock
                        x:Name="StateText"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    x:Name="TitleText"
                    Grid.Row="1"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource NotchPrimaryTextBrush}"
                    LineHeight="16"
                    LineStackingStrategy="BlockLineHeight"
                    MaxLines="2"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap" />
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  How well it is known: the cards mastered, of all.  -->
                    <Grid Height="4" VerticalAlignment="Center">
                        <Border Background="{StaticResource NotchTrackBrush}" CornerRadius="2" />
                        <Border
                            x:Name="MasteryFill"
                            HorizontalAlignment="Left"
                            CornerRadius="2" />
                    </Grid>
                    <TextBlock
                        x:Name="CountText"
                        Grid.Column="1"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="10.5"
                        Foreground="{StaticResource NotchSecondaryTextBrush}"
                        Typography.NumeralAlignment="Tabular" />
                </Grid>
            </Grid>
        </controls:MotionButton>

        <!--  The course open in the sheet.  -->
        <Border
            x:Name="Ring"
            BorderBrush="#99FFFFFF"
            BorderThickness="1.5"
            CornerRadius="16"
            IsHitTestVisible="False"
            Opacity="0" />
    </Grid>
</UserControl>
