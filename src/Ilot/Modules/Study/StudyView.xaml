<UserControl
    x:Class="Ilot.Modules.Study.StudyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls">

    <!--
        The sections (subjects) above, then the courses of the one chosen as a row of cards, like the notes; a click opens
        one in a sheet below (a CourseSheet, in the notch's bubble: revision, summary sheet, cards, mind maps).
        Vertical positions are set from the tab bar height in code.
    -->
    <Grid x:Name="LayoutRoot">
        <!--  The sections (subjects): « Global » first (every course), the user's, « + » to make one. Set in code.  -->
        <ScrollViewer
            x:Name="SectionsScroller"
            Height="30"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <StackPanel
                x:Name="SectionsRow"
                Padding="20,0,20,0"
                Orientation="Horizontal"
                Spacing="4" />
        </ScrollViewer>

        <ScrollViewer
            x:Name="Scroller"
            Height="104"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <StackPanel
                x:Name="Tiles"
                Padding="20,4,20,4"
                Orientation="Horizontal"
                Spacing="8">
                <!--  Everything due in the section shown, first, lit in its colour; « À jour », dimmed, when nothing is.  -->
                <controls:MotionButton
                    x:Name="ReviewAllTile"
                    Width="128"
                    Height="96"
                    Click="OnReviewAllClick"
                    HaloOpacity="0.08"
                    HaloRestScale="1"
                    HoverScale="0.03"
                    PressScale="0.05"
                    Style="{StaticResource NotchCardButtonStyle}"
                    Visibility="Collapsed">
                    <Grid Margin="14,10,12,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="ReviewAllCount"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="28"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Typography.NumeralAlignment="Tabular" />
                        <FontIcon
                            x:Name="ReviewAllDone"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontSize="24"
                            Foreground="White"
                            Glyph="&#xE73E;"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="ReviewAllLabel"
                            Grid.Row="1"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11.5"
                            Foreground="#D9FFFFFF" />
                        <StackPanel
                            Grid.Row="2"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBlock
                                x:Name="ReviewAllAction"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Réviser" />
                            <FontIcon
                                x:Name="ReviewAllArrow"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="White"
                                Glyph="&#xE72A;" />
                        </StackPanel>
                    </Grid>
                </controls:MotionButton>
                <Grid Width="104" Height="96">
                    <controls:MotionButton
                        x:Name="ImportCard"
                        AutomationProperties.Name="Importer un cours"
                        Background="Transparent"
                        Click="OnImportClick"
                        HaloOpacity="0.06"
                        HaloRestScale="1"
                        HoverScale="0.04"
                        PressScale="0.06"
                        Style="{StaticResource NotchCardButtonStyle}"
                        ToolTipService.ToolTip="Un PDF, un Word, un PowerPoint ou une photo de vos notes : Notch en fait une fiche et des flashcards">
                        <Grid>
                            <Rectangle
                                x:Name="ImportFrame"
                                RadiusX="16"
                                RadiusY="16"
                                Stroke="#40FFFFFF"
                                StrokeDashArray="3,3"
                                StrokeThickness="1.5" />
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="7">
                                <FontIcon FontSize="16" Glyph="&#xE8E5;" />
                                <TextBlock
                                    FontFamily="Segoe UI Variable Text"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Text="Importer un cours"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </controls:MotionButton>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  No course yet; or why one could not be taken.  -->
        <TextBlock
            x:Name="RowHint"
            Width="420"
            Margin="144,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Style="{StaticResource NotchSubtitleTextStyle}"
            Text="Glissez un cours ici (PDF, Word, PowerPoint, photo) : Notch en fait une fiche de révision et des flashcards, révisées au bon moment."
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
