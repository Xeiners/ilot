<UserControl
    x:Class="Ilot.Modules.Study.ReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    RequestedTheme="Dark"
    UseSystemFocusVisuals="False">

    <!--
        A revision: what is left, a card (its question, its four choices or « Afficher la réponse », then its answer),
        and how well it came; the cards answered, looked back at. In a course's sheet (see CourseSheet).
    -->
    <Grid Padding="24,10,24,18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The cards answered in this session: back to them (read only), and forward again.  -->
        <controls:MotionButton
            x:Name="PreviousButton"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#14FFFFFF"
            Click="OnPreviousClick"
            Style="{StaticResource StudyChoiceStyle}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="10" Glyph="&#xE72B;" />
                <TextBlock FontSize="12" Text="Précédente" />
            </StackPanel>
        </controls:MotionButton>
        <TextBlock
            x:Name="LookLabel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Segoe UI Variable Text"
            FontSize="12"
            Foreground="{StaticResource NotchSecondaryTextBrush}"
            Visibility="Collapsed" />
        <controls:MotionButton
            x:Name="ForwardButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#14FFFFFF"
            Click="OnForwardClick"
            Style="{StaticResource StudyChoiceStyle}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock FontSize="12" Text="Suivante" />
                <FontIcon FontSize="10" Glyph="&#xE72A;" />
            </StackPanel>
        </controls:MotionButton>

        <!--  Every grade so far (see ShowGrades); again, back to the session.  -->
        <controls:MotionButton
            x:Name="HistoryButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#14FFFFFF"
            Click="OnHistoryClick"
            Style="{StaticResource StudyChoiceStyle}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon
                    x:Name="HistoryGlyph"
                    FontSize="11"
                    Glyph="&#xE81C;" />
                <TextBlock x:Name="HistoryButtonText" FontSize="12" />
            </StackPanel>
        </controls:MotionButton>

        <!--  Where the session is: « Carte 3 sur 20 », and its bar.  -->
        <StackPanel
            x:Name="Counts"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="6">
            <TextBlock
                x:Name="ProgressText"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI Variable Text"
                FontSize="12"
                Foreground="#B3FFFFFF"
                Typography.NumeralAlignment="Tabular" />
            <Grid
                Width="180"
                Height="4"
                HorizontalAlignment="Center">
                <Border Background="#1FFFFFFF" CornerRadius="2" />
                <Border
                    x:Name="ProgressFill"
                    Width="0"
                    HorizontalAlignment="Left"
                    CornerRadius="2" />
            </Grid>
        </StackPanel>

        <ScrollViewer
            x:Name="FaceScroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="720" VerticalAlignment="Center">
            <Border
                x:Name="Face"
                Padding="28,20,28,22"
                VerticalAlignment="Center"
                Background="{StaticResource NotchCardBrush}"
                BorderBrush="#14FFFFFF"
                BorderThickness="1"
                CornerRadius="24">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="ChapterText"
                        HorizontalAlignment="Center"
                        CharacterSpacing="40"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchSecondaryTextBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="QuestionText"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchPrimaryTextBrush}"
                        IsTextSelectionEnabled="True"
                        LineHeight="27"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <!--  The question with its formulas drawn, when it has some (see StudyMathView).  -->
                    <ContentPresenter x:Name="QuestionMath" Visibility="Collapsed" />
                    <!--  Four choices (1 to 4), when the card has them.  -->
                    <StackPanel
                        x:Name="Options"
                        Margin="0,6,0,0"
                        Spacing="8"
                        Visibility="Collapsed" />
                    <StackPanel
                        x:Name="AnswerArea"
                        Spacing="12"
                        Visibility="Collapsed">
                        <Border
                            Height="1"
                            Margin="40,6,40,4"
                            Background="#1FFFFFFF" />
                        <TextBlock
                            x:Name="AnswerText"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="16"
                            Foreground="#F0FFFFFF"
                            IsTextSelectionEnabled="True"
                            LineHeight="24"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <ContentPresenter x:Name="AnswerMath" Visibility="Collapsed" />
                        <TextBlock
                            x:Name="SourceText"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11.5"
                            Foreground="{StaticResource NotchSecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--  A flash on the card, green or red, as a choice is answered (see Flash).  -->
            <Border
                x:Name="FaceFlash"
                BorderThickness="2"
                CornerRadius="24"
                IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>

        <!--
            The session done: its grade out of 20, its cards by how they came, how it compares with the last one, the
            sessions before as bars, then the next session (or when the next card is due). Nothing to revise: the
            sessions before, still.
        -->
        <ScrollViewer
            x:Name="DonePanel"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon
                    x:Name="DoneIcon"
                    FontSize="28"
                    Foreground="#FF6CD97E"
                    Glyph="&#xE73E;" />
                <TextBlock
                    x:Name="GradeText"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontWeight="SemiBold"
                    Typography.NumeralAlignment="Tabular">
                    <Run x:Name="GradeValue" FontSize="46" />
                    <Run
                        FontSize="20"
                        Foreground="#8FFFFFFF"
                        Text="/20" />
                </TextBlock>
                <TextBlock
                    x:Name="DoneTitle"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource NotchPrimaryTextBrush}" />
                <StackPanel
                    x:Name="Tally"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="16" />
                <TextBlock
                    x:Name="TrendText"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12.5"
                    FontWeight="SemiBold" />
                <StackPanel
                    x:Name="HistoryArea"
                    Margin="0,10,0,0"
                    Spacing="8">
                    <TextBlock
                        x:Name="HistoryTitle"
                        HorizontalAlignment="Center"
                        CharacterSpacing="40"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="10.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchSecondaryTextBrush}"
                        Text="VOS DERNIÈRES SESSIONS" />
                    <Grid
                        x:Name="HistoryChart"
                        Height="72"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="HistoryText"
                        HorizontalAlignment="Center"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="12"
                        Foreground="{StaticResource NotchSecondaryTextBrush}"
                        Typography.NumeralAlignment="Tabular" />
                </StackPanel>
                <TextBlock
                    x:Name="DoneText"
                    MaxWidth="440"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="13"
                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <controls:MotionButton
                    x:Name="NextSessionButton"
                    Height="42"
                    MinWidth="240"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    AllowFocusOnInteraction="False"
                    Background="#F2FFFFFF"
                    Click="OnNextSessionClick"
                    Foreground="#FF111114"
                    HaloOpacity="0.1"
                    HaloRestScale="1"
                    HoverScale="0.03"
                    PressScale="0.05"
                    Style="{StaticResource StudyPillStyle}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon FontSize="13" Glyph="&#xE72C;" />
                        <TextBlock x:Name="NextSessionText" FontSize="14" />
                        <Border
                            Padding="6,1"
                            VerticalAlignment="Center"
                            Background="#1A000000"
                            CornerRadius="5">
                            <TextBlock FontSize="11" Text="Espace" />
                        </Border>
                    </StackPanel>
                </controls:MotionButton>
            </StackPanel>
        </ScrollViewer>

        <!--
            Every grade so far: their average, best and last, all of them as bars, then each, the latest first (when,
            the grade, its cards by how they came, the change since the one before).
        -->
        <ScrollViewer
            x:Name="GradesPanel"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <StackPanel
                MaxWidth="560"
                Padding="0,4,0,8"
                Spacing="14">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="17"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource NotchPrimaryTextBrush}"
                    Text="Historique de vos notes" />
                <StackPanel
                    x:Name="GradesStats"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10" />
                <Grid
                    x:Name="GradesChart"
                    Height="72"
                    HorizontalAlignment="Center" />
                <StackPanel x:Name="GradesList" Spacing="6" />
                <TextBlock
                    x:Name="GradesEmpty"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="13"
                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                    Text="Aucune note pour l'instant : terminez une session pour avoir la première."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!--
            Show the answer; then how well it came (1 to 4), with when the card comes back. A choice made,
            one line: the four ratings small, to adjust it, then « Suivant », which gives the rating offered.
        -->
        <StackPanel
            x:Name="AnswerBar"
            Grid.Row="2"
            HorizontalAlignment="Center"
            Spacing="10">
            <controls:MotionButton
                x:Name="ShowAnswerButton"
                Height="44"
                AllowFocusOnInteraction="False"
                MinWidth="260"
                Background="#F2FFFFFF"
                Click="OnShowAnswerClick"
                Foreground="#FF111114"
                HaloOpacity="0.1"
                HaloRestScale="1"
                HoverScale="0.03"
                PressScale="0.05"
                Style="{StaticResource StudyPillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        x:Name="ShowAnswerText"
                        FontSize="14"
                        Text="Afficher la réponse" />
                    <Border
                        x:Name="SpaceBadge"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="#1A000000"
                        CornerRadius="5">
                        <TextBlock FontSize="11" Text="Espace" />
                    </Border>
                </StackPanel>
            </controls:MotionButton>
            <StackPanel
                x:Name="RatingButtons"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="AdjustLabel"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="11.5"
                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                    Text="Ajuster :"
                    Visibility="Collapsed" />
                <controls:MotionButton
                    x:Name="AgainButton"
                    Background="#33FF6B6B"
                    Click="OnRateClick"
                    Style="{StaticResource StudyRateStyle}"
                    Tag="1">
                    <StackPanel Spacing="1">
                        <TextBlock HorizontalAlignment="Center" Text="À revoir" />
                        <TextBlock
                            x:Name="AgainSpan"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Normal"
                            Opacity="0.7" />
                    </StackPanel>
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="HardButton"
                    Background="#33FFB86B"
                    Click="OnRateClick"
                    Style="{StaticResource StudyRateStyle}"
                    Tag="2">
                    <StackPanel Spacing="1">
                        <TextBlock HorizontalAlignment="Center" Text="Difficile" />
                        <TextBlock
                            x:Name="HardSpan"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Normal"
                            Opacity="0.7" />
                    </StackPanel>
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="GoodButton"
                    Background="#336CD97E"
                    Click="OnRateClick"
                    Style="{StaticResource StudyRateStyle}"
                    Tag="3">
                    <StackPanel Spacing="1">
                        <TextBlock HorizontalAlignment="Center" Text="Bien" />
                        <TextBlock
                            x:Name="GoodSpan"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Normal"
                            Opacity="0.7" />
                    </StackPanel>
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="EasyButton"
                    Background="#336CB8FF"
                    Click="OnRateClick"
                    Style="{StaticResource StudyRateStyle}"
                    Tag="4">
                    <StackPanel Spacing="1">
                        <TextBlock HorizontalAlignment="Center" Text="Facile" />
                        <TextBlock
                            x:Name="EasySpan"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Normal"
                            Opacity="0.7" />
                    </StackPanel>
                </controls:MotionButton>
            </StackPanel>
            <controls:MotionButton
                x:Name="NextCardButton"
                Height="44"
                MinWidth="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AllowFocusOnInteraction="False"
                Background="#F2FFFFFF"
                Click="OnNextCardClick"
                Foreground="#FF111114"
                HaloOpacity="0.1"
                HaloRestScale="1"
                HoverScale="0.03"
                PressScale="0.05"
                Style="{StaticResource StudyPillStyle}"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock FontSize="14" Text="Suivant" />
                    <Border
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="#1A000000"
                        CornerRadius="5">
                        <TextBlock FontSize="11" Text="Espace" />
                    </Border>
                </StackPanel>
            </controls:MotionButton>
            <controls:MotionButton
                x:Name="ResumeButton"
                Height="40"
                MinWidth="220"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AllowFocusOnInteraction="False"
                Background="#F2FFFFFF"
                Click="OnResumeClick"
                Foreground="#FF111114"
                HaloOpacity="0.1"
                HaloRestScale="1"
                HoverScale="0.03"
                PressScale="0.05"
                Style="{StaticResource StudyPillStyle}"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="14" Text="Reprendre" />
                    <FontIcon FontSize="11" Glyph="&#xE72A;" />
                </StackPanel>
            </controls:MotionButton>
        </StackPanel>
    </Grid>
</UserControl>
