<UserControl
    x:Class="Ilot.Modules.Study.ReviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls"
    IsTabStop="True"
    KeyDown="OnKeyDown"
    RequestedTheme="Dark"
    UseSystemFocusVisuals="False">

    <!--
        A revision: what is left, a card (its question, its four choices or « Afficher la réponse », then its answer),
        and how well it came; the cards answered, looked back at. In a course's sheet (see CourseSheet).
    -->
    <Grid Padding="24,10,24,18" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  The cards answered in this session: back to them (read only), and forward again.  -->
        <controls:MotionButton
            x:Name="PreviousButton"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="#14FFFFFF"
            Click="OnPreviousClick"
            Style="{StaticResource StudyChoiceStyle}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon FontSize="10" Glyph="&#xE72B;" />
                <TextBlock FontSize="12" Text="Précédente" />
            </StackPanel>
        </controls:MotionButton>
        <TextBlock
            x:Name="LookLabel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Segoe UI Variable Text"
            FontSize="12"
            Foreground="{StaticResource NotchSecondaryTextBrush}"
            Visibility="Collapsed" />
        <controls:MotionButton
            x:Name="ForwardButton"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="#14FFFFFF"
            Click="OnForwardClick"
            Style="{StaticResource StudyChoiceStyle}"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock FontSize="12" Text="Suivante" />
                <FontIcon FontSize="10" Glyph="&#xE72A;" />
            </StackPanel>
        </controls:MotionButton>

        <!--  What is left: new, being learnt, to review.  -->
        <StackPanel
            x:Name="Counts"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="16">
            <TextBlock FontFamily="Segoe UI Variable Text" FontSize="12" Typography.NumeralAlignment="Tabular">
                <Run x:Name="NewCount" FontWeight="SemiBold" Foreground="#FF6CB8FF" />
                <Run x:Name="NewLabel" Foreground="#8FFFFFFF" />
            </TextBlock>
            <TextBlock FontFamily="Segoe UI Variable Text" FontSize="12" Typography.NumeralAlignment="Tabular">
                <Run x:Name="LearningCount" FontWeight="SemiBold" Foreground="#FFFF8A65" />
                <Run x:Name="LearningLabel" Foreground="#8FFFFFFF" />
            </TextBlock>
            <TextBlock FontFamily="Segoe UI Variable Text" FontSize="12" Typography.NumeralAlignment="Tabular">
                <Run x:Name="ReviewCount" FontWeight="SemiBold" Foreground="#FF6CD97E" />
                <Run x:Name="ReviewLabel" Foreground="#8FFFFFFF" />
            </TextBlock>
        </StackPanel>

        <ScrollViewer
            x:Name="FaceScroller"
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="720" VerticalAlignment="Center">
            <Border
                x:Name="Face"
                Padding="28,20,28,22"
                VerticalAlignment="Center"
                Background="{StaticResource NotchCardBrush}"
                BorderBrush="#14FFFFFF"
                BorderThickness="1"
                CornerRadius="24">
                <StackPanel Spacing="12">
                    <TextBlock
                        x:Name="ChapterText"
                        HorizontalAlignment="Center"
                        CharacterSpacing="40"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchSecondaryTextBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="QuestionText"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchPrimaryTextBrush}"
                        IsTextSelectionEnabled="True"
                        LineHeight="27"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <!--  Four choices (1 to 4), when the card has them.  -->
                    <StackPanel
                        x:Name="Options"
                        Margin="0,6,0,0"
                        Spacing="8"
                        Visibility="Collapsed" />
                    <StackPanel
                        x:Name="AnswerArea"
                        Spacing="12"
                        Visibility="Collapsed">
                        <Border
                            Height="1"
                            Margin="40,6,40,4"
                            Background="#1FFFFFFF" />
                        <TextBlock
                            x:Name="AnswerText"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="16"
                            Foreground="#F0FFFFFF"
                            IsTextSelectionEnabled="True"
                            LineHeight="24"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="SourceText"
                            HorizontalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11.5"
                            Foreground="{StaticResource NotchSecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <!--  A flash on the card, green or red, as a choice is answered (see Flash).  -->
            <Border
                x:Name="FaceFlash"
                BorderThickness="2"
                CornerRadius="24"
                IsHitTestVisible="False" />
            </Grid>
        </ScrollViewer>

        <!--  Nothing left for now.  -->
        <StackPanel
            x:Name="DonePanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed">
            <FontIcon
                FontSize="30"
                Foreground="#FF6CD97E"
                Glyph="&#xE73E;" />
            <TextBlock
                x:Name="DoneTitle"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{StaticResource NotchPrimaryTextBrush}" />
            <TextBlock
                x:Name="DoneText"
                MaxWidth="440"
                FontFamily="Segoe UI Variable Text"
                FontSize="13"
                Foreground="{StaticResource NotchSecondaryTextBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--
            Show the answer; then how well it came (1 to 4), with when the card comes back. A choice made,
            one line: the four ratings small, to adjust it, then « Suivant », which gives the rating offered.
        -->
        <StackPanel
            x:Name="AnswerBar"
            Grid.Row="2"
            HorizontalAlignment="Center"
            Spacing="10">
            <controls:MotionButton
                x:Name="ShowAnswerButton"
                Height="44"
                AllowFocusOnInteraction="False"
                MinWidth="260"
                Background="#F2FFFFFF"
                Click="OnShowAnswerClick"
                Foreground="#FF111114"
                HaloOpacity="0.1"
                HaloRestScale="1"
                HoverScale="0.03"
                PressScale="0.05"
                Style="{StaticResource StudyPillStyle}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock
                        x:Name="ShowAnswerText"
                        FontSize="14"
                        Text="Afficher la réponse" />
                    <Border
                        x:Name="SpaceBadge"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="#1A000000"
                        CornerRadius="5">
                        <TextBlock FontSize="11" Text="Espace" />
                    </Border>
                </StackPanel>
            </controls:MotionButton>
            <StackPanel
                x:Name="RatingButtons"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8"
                Visibility="Collapsed">
                <TextBlock
                    x:Name="AdjustLabel"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="11.5"
                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                    Text="Ajuster :"
                    Visibility="Collapsed" />
                <controls:MotionButton
                    x:Name="AgainButton"
                    Background="#33FF6B6B"
                    Click="OnRateClick"
                    Style="{StaticResource StudyRateStyle}"
                    Tag="1">
                    <StackPanel Spacing="1">
                        <TextBlock HorizontalAlignment="Center" Text="À revoir" />
                        <TextBlock
                            x:Name="AgainSpan"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Normal"
                            Opacity="0.7" />
                    </StackPanel>
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="HardButton"
                    Background="#33FFB86B"
                    Click="OnRateClick"
                    Style="{StaticResource StudyRateStyle}"
                    Tag="2">
                    <StackPanel Spacing="1">
                        <TextBlock HorizontalAlignment="Center" Text="Difficile" />
                        <TextBlock
                            x:Name="HardSpan"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Normal"
                            Opacity="0.7" />
                    </StackPanel>
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="GoodButton"
                    Background="#336CD97E"
                    Click="OnRateClick"
                    Style="{StaticResource StudyRateStyle}"
                    Tag="3">
                    <StackPanel Spacing="1">
                        <TextBlock HorizontalAlignment="Center" Text="Bien" />
                        <TextBlock
                            x:Name="GoodSpan"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Normal"
                            Opacity="0.7" />
                    </StackPanel>
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="EasyButton"
                    Background="#336CB8FF"
                    Click="OnRateClick"
                    Style="{StaticResource StudyRateStyle}"
                    Tag="4">
                    <StackPanel Spacing="1">
                        <TextBlock HorizontalAlignment="Center" Text="Facile" />
                        <TextBlock
                            x:Name="EasySpan"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            FontWeight="Normal"
                            Opacity="0.7" />
                    </StackPanel>
                </controls:MotionButton>
            </StackPanel>
            <controls:MotionButton
                x:Name="NextCardButton"
                Height="44"
                MinWidth="260"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AllowFocusOnInteraction="False"
                Background="#F2FFFFFF"
                Click="OnNextCardClick"
                Foreground="#FF111114"
                HaloOpacity="0.1"
                HaloRestScale="1"
                HoverScale="0.03"
                PressScale="0.05"
                Style="{StaticResource StudyPillStyle}"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock FontSize="14" Text="Suivant" />
                    <Border
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="#1A000000"
                        CornerRadius="5">
                        <TextBlock FontSize="11" Text="Espace" />
                    </Border>
                </StackPanel>
            </controls:MotionButton>
            <controls:MotionButton
                x:Name="ResumeButton"
                Height="40"
                MinWidth="220"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AllowFocusOnInteraction="False"
                Background="#F2FFFFFF"
                Click="OnResumeClick"
                Foreground="#FF111114"
                HaloOpacity="0.1"
                HaloRestScale="1"
                HoverScale="0.03"
                PressScale="0.05"
                Style="{StaticResource StudyPillStyle}"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="14" Text="Reprendre" />
                    <FontIcon FontSize="11" Glyph="&#xE72A;" />
                </StackPanel>
            </controls:MotionButton>
        </StackPanel>
    </Grid>
</UserControl>
