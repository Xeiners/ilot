<UserControl
    x:Class="Ilot.Modules.Clipboard.ClipboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls">

    <!--
        A row of tiles that scrolls sideways (wheel or touchpad), fitted to the wide and low notch: pinned items
        first, then the latest copies. It spans the whole width, so the tiles slide out under the notch's own
        rounded edges. Vertical positions are set from the tab bar height in code.
    -->
    <Grid x:Name="LayoutRoot">
        <ScrollViewer
            x:Name="Scroller"
            Height="104"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <StackPanel
                x:Name="Cards"
                Padding="20,4,20,4"
                Orientation="Horizontal"
                Spacing="8" />
        </ScrollViewer>

        <StackPanel
            x:Name="EmptyState"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Spacing="3"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                Margin="0,0,0,4"
                FontSize="20"
                Foreground="{StaticResource NotchSecondaryTextBrush}"
                Glyph="&#xE77F;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource NotchTitleTextStyle}"
                FontSize="14"
                Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource NotchSubtitleTextStyle}"
                Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}" />
        </StackPanel>

        <!--  The search found nothing.  -->
        <StackPanel
            x:Name="NoResults"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Spacing="3"
            Visibility="Collapsed">
            <FontIcon
                Margin="0,0,0,4"
                FontSize="20"
                Foreground="{StaticResource NotchSecondaryTextBrush}"
                Glyph="&#xE721;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource NotchTitleTextStyle}"
                FontSize="14"
                Text="Aucun résultat" />
            <TextBlock
                x:Name="NoResultsText"
                MaxWidth="420"
                HorizontalAlignment="Center"
                Style="{StaticResource NotchSubtitleTextStyle}" />
        </StackPanel>

        <!--  Search, next to the clear button (placed in code): a magnifier that unfolds into a field.  -->
        <controls:NotchSearchBox
            x:Name="Search"
            Margin="0,1,42,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Label="Rechercher dans le presse-papier"
            Visibility="{x:Bind ViewModel.HasEntries, Mode=OneWay}" />

        <!--  Clearing asks first: the row steps back and this question takes its place.  -->
        <StackPanel
            x:Name="ConfirmPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Spacing="3">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource NotchTitleTextStyle}"
                FontSize="14"
                Text="Nettoyer le presse-papier ?" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource NotchSubtitleTextStyle}"
                Text="{x:Bind ViewModel.ClearPrompt, Mode=OneWay}" />
            <StackPanel
                Margin="0,10,0,0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <controls:MotionButton
                    Click="OnCancelClearClick"
                    Content="Annuler"
                    HaloOpacity="0.1"
                    HaloRestScale="1"
                    HoverScale="0.04"
                    PressScale="0.06"
                    Style="{StaticResource NotchPillButtonStyle}" />
                <controls:MotionButton
                    Background="{StaticResource NotchDangerBrush}"
                    Click="OnConfirmClearClick"
                    Content="Effacer"
                    HaloOpacity="0.14"
                    HaloRestScale="1"
                    HoverScale="0.04"
                    PressScale="0.06"
                    Style="{StaticResource NotchPillButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <!--  Clear everything but the pinned items: at the right end of the tab bar row.  -->
        <controls:MotionButton
            x:Name="ClearButton"
            Width="26"
            Height="26"
            Margin="0,1,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            AutomationProperties.Name="Nettoyer le presse-papier"
            Click="OnClearClick"
            ToolTipService.ToolTip="Nettoyer (sauf les épinglés)"
            Visibility="{x:Bind ViewModel.CanClear, Mode=OneWay}">
            <FontIcon FontSize="13" Glyph="&#xEA99;" />
        </controls:MotionButton>
    </Grid>
</UserControl>
