<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Ilot.Controls">

    <!--  Design tokens  -->
    <SolidColorBrush x:Key="NotchPrimaryTextBrush" Color="#F5FFFFFF" />
    <SolidColorBrush x:Key="NotchSecondaryTextBrush" Color="#8FFFFFFF" />
    <SolidColorBrush x:Key="NotchGlyphBrush" Color="#F7FFFFFF" />
    <SolidColorBrush x:Key="NotchTrackBrush" Color="#2EFFFFFF" />
    <SolidColorBrush x:Key="NotchTrackFillBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="NotchPlaceholderBrush" Color="#FF1C1C1F" />
    <SolidColorBrush x:Key="NotchCardBrush" Color="#FF161618" />
    <SolidColorBrush x:Key="NotchPinBrush" Color="#FFFFC857" />
    <SolidColorBrush x:Key="NotchPillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="NotchDangerBrush" Color="#FFE5484D" />
    <SolidColorBrush x:Key="NotchHighlightBrush" Color="#FFFFC857" />
    <SolidColorBrush x:Key="NotchHighlightTextBrush" Color="#FF16130C" />
    <SolidColorBrush x:Key="NotchFieldBrush" Color="#1FFFFFFF" />

    <Style x:Key="NotchTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NotchPrimaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>

    <Style x:Key="NotchSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource NotchSecondaryTextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>

    <!--  Settings window: a Windows 11 settings card.  -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!--  Lyric line: set large and bright; the dimmed "next line" look comes from scale and opacity.  -->
    <Style x:Key="NotchLyricTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!--  Elapsed / remaining time: tabular figures so the digits do not dance while they change.  -->
    <Style x:Key="NotchTimeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource NotchSecondaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!--  Vector glyphs: filled, with round joins so the corners come out softly rounded.  -->
    <Style x:Key="NotchGlyphStyle" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource NotchGlyphBrush}" />
        <Setter Property="Stroke" Value="{StaticResource NotchGlyphBrush}" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Transport button: hover / press feedback is driven by springs in MotionButton.cs  -->
    <Style TargetType="controls:MotionButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource NotchGlyphBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MotionButton">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Opacity" Value="0.3" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Ellipse x:Name="Halo" Fill="White" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Tab of the open notch: a pill-shaped halo; the selection pill itself is drawn by NotchView.  -->
    <Style x:Key="NotchTabButtonStyle" TargetType="controls:MotionButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource NotchPrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MotionButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Halo" Background="White" CornerRadius="11" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Clipboard card: a rounded tile that lightens under the pointer.  -->
    <Style x:Key="NotchCardButtonStyle" TargetType="controls:MotionButton">
        <!--  A button hugs its content by default: the tile must fill the whole card.  -->
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource NotchCardBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NotchPrimaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MotionButton">
                    <!--  The tile as a whole swells and squashes; the halo lightens it from within.  -->
                    <Grid
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        CornerRadius="16">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                        <Border
                            x:Name="Halo"
                            Background="White"
                            CornerRadius="16"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Text field inside a notch pill: just the text and the caret, the pill around it is the field.  -->
    <Style x:Key="NotchFieldTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource NotchPrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsSpellCheckEnabled" Value="False" />
        <Setter Property="IsTextPredictionEnabled" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer
                        x:Name="ContentElement"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        IsTabStop="False"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        ZoomMode="Disabled" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Text button in the notch (confirmations): a pill that lightens under the pointer.  -->
    <Style x:Key="NotchPillButtonStyle" TargetType="controls:MotionButton">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{StaticResource NotchPillBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NotchPrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:MotionButton">
                    <Grid
                        x:Name="ContentPresenter"
                        Background="{TemplateBinding Background}"
                        CornerRadius="14">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}" />
                        <Border
                            x:Name="Halo"
                            Background="White"
                            CornerRadius="14"
                            IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Scrubber: hover / drag feedback is driven by springs in Scrubber.cs  -->
    <Style TargetType="controls:Scrubber">
        <Setter Property="Height" Value="16" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:Scrubber">
                    <!--  Transparent: the whole 16 px row is easy to grab, not just the 4 px bar.  -->
                    <Grid Background="Transparent">
                        <Grid x:Name="Bar" Height="4" VerticalAlignment="Center">
                            <Border Background="{StaticResource NotchTrackBrush}" CornerRadius="2" />
                            <Border x:Name="Fill" Background="{StaticResource NotchTrackFillBrush}" CornerRadius="2" />
                        </Grid>
                        <Ellipse
                            x:Name="Knob"
                            Width="11"
                            Height="11"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Fill="White" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The revisions (Modules/Study): a course's sheet, under the notch or in its own window.  -->
    <!--  A pill hugging its icon and label.  -->
    <Style
        x:Key="StudyPillStyle"
        BasedOn="{StaticResource NotchPillButtonStyle}"
        TargetType="controls:MotionButton">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <!--  A mode of the sheet (Réviser, Fiche, Cartes) or a choice (a chapter, a count): lit when chosen.  -->
    <Style
        x:Key="StudyChoiceStyle"
        BasedOn="{StaticResource NotchPillButtonStyle}"
        TargetType="controls:MotionButton">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
    </Style>

    <!--  A rating, under the answer: its word, and when the card comes back.  -->
    <Style
        x:Key="StudyRateStyle"
        BasedOn="{StaticResource NotchPillButtonStyle}"
        TargetType="controls:MotionButton">
        <Setter Property="Height" Value="52" />
        <Setter Property="MinWidth" Value="118" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="AllowFocusOnInteraction" Value="False" />
    </Style>
</ResourceDictionary>
