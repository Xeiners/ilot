<UserControl
    x:Class="MyNotch.Modules.DropZone.IncomingFileCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyNotch.Controls"
    Width="392"
    Height="52">

    <!--
        A file from the phone, waiting for an answer, the way an incoming call shows on the Dynamic Island: what it is,
        then decline (red) or accept (green). Several files waiting are answered together.
    -->
    <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="IconStage"
            Width="44"
            Height="44"
            VerticalAlignment="Center">
            <Ellipse>
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#5522D3EE" />
                        <GradientStop Offset="1" Color="#1422D3EE" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <FontIcon
                x:Name="KindIcon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="19"
                Foreground="White" />
            <!--  Coming in: a small arrow down, bottom right.  -->
            <Border
                Width="18"
                Height="18"
                Margin="0,0,-2,-2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#FF22D3EE"
                BorderBrush="Black"
                BorderThickness="2"
                CornerRadius="9">
                <FontIcon
                    FontSize="8"
                    FontWeight="Bold"
                    Foreground="Black"
                    Glyph="&#xE74B;" />
            </Border>
        </Grid>

        <StackPanel
            x:Name="Details"
            Grid.Column="1"
            VerticalAlignment="Center"
            Spacing="1">
            <TextBlock
                x:Name="TitleText"
                FontFamily="Segoe UI Variable Display"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="White"
                MaxLines="1"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                x:Name="DetailText"
                Style="{StaticResource NotchSubtitleTextStyle}"
                FontSize="12"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                Typography.NumeralAlignment="Tabular" />
        </StackPanel>

        <StackPanel
            x:Name="Answers"
            Grid.Column="2"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="8">
            <controls:MotionButton
                x:Name="RefuseButton"
                MinWidth="0"
                Padding="12,0"
                AutomationProperties.Name="Refuser"
                Background="#33FF453A"
                Click="OnRefuseClick"
                Foreground="#FFFF6B6B"
                HaloOpacity="0.1"
                HaloRestScale="1"
                HoverScale="0.05"
                PressScale="0.08"
                Style="{StaticResource NotchPillButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="11" Glyph="&#xE711;" />
                    <TextBlock Text="Refuser" />
                </StackPanel>
            </controls:MotionButton>
            <controls:MotionButton
                x:Name="AcceptButton"
                MinWidth="0"
                Padding="12,0"
                AutomationProperties.Name="Accepter"
                Background="#FF34C759"
                Click="OnAcceptClick"
                Foreground="Black"
                HaloOpacity="0.18"
                HaloRestScale="1"
                HoverScale="0.05"
                PressScale="0.08"
                Style="{StaticResource NotchPillButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="11" Glyph="&#xE73E;" />
                    <TextBlock Text="Accepter" />
                </StackPanel>
            </controls:MotionButton>
        </StackPanel>
    </Grid>
</UserControl>
