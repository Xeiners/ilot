<UserControl
    x:Class="MyNotch.Modules.DropZone.LocalMessageCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyNotch.Controls"
    MaxWidth="480"
    MinWidth="200">

    <UserControl.Resources>
        <Style
            x:Key="ChatActionButtonStyle"
            BasedOn="{StaticResource NotchPillButtonStyle}"
            TargetType="controls:MotionButton">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Background" Value="#1FFFFFFF" />
        </Style>
    </UserControl.Resources>

    <Border
        x:Name="BubbleBorder"
        Padding="14,10,14,12"
        BorderThickness="1">
        <StackPanel Spacing="7">
            <!--  ── Sender, time, and quick actions ──  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="MetaText"
                    VerticalAlignment="Center"
                    Style="{StaticResource NotchSubtitleTextStyle}"
                    FontSize="11.5"
                    Typography.NumeralAlignment="Tabular" />

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">
                    <controls:MotionButton
                        x:Name="OpenLinkButton"
                        AutomationProperties.Name="Ouvrir le lien"
                        Click="OnOpenLinkClick"
                        Style="{StaticResource ChatActionButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="10" Glyph="&#xE8A7;" />
                            <TextBlock Text="Ouvrir" />
                        </StackPanel>
                    </controls:MotionButton>

                    <controls:MotionButton
                        x:Name="CopyButton"
                        AutomationProperties.Name="Copier dans le presse-papier"
                        Click="OnCopyClick"
                        Style="{StaticResource ChatActionButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon
                                x:Name="CopyIcon"
                                FontSize="10"
                                Glyph="&#xE8C8;" />
                            <TextBlock x:Name="CopyLabel" Text="Copier" />
                        </StackPanel>
                    </controls:MotionButton>

                    <controls:MotionButton
                        x:Name="SaveImageButton"
                        AutomationProperties.Name="Enregistrer dans Téléchargements"
                        Click="OnSaveImageClick"
                        Style="{StaticResource ChatActionButtonStyle}"
                        ToolTipService.ToolTip="Enregistrer dans Téléchargements"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon
                                x:Name="SaveIcon"
                                FontSize="10"
                                Glyph="&#xE74E;" />
                            <TextBlock x:Name="SaveLabel" Text="Enregistrer" />
                        </StackPanel>
                    </controls:MotionButton>

                    <controls:MotionButton
                        x:Name="RefuseButton"
                        AutomationProperties.Name="Refuser le fichier"
                        Background="#33FF453A"
                        Click="OnRefuseClick"
                        Foreground="#FFFF6B6B"
                        Style="{StaticResource ChatActionButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="10" Glyph="&#xE711;" />
                            <TextBlock Text="Refuser" />
                        </StackPanel>
                    </controls:MotionButton>

                    <controls:MotionButton
                        x:Name="AcceptButton"
                        AutomationProperties.Name="Accepter le fichier"
                        Background="#FF34C759"
                        Click="OnAcceptClick"
                        Foreground="Black"
                        Style="{StaticResource ChatActionButtonStyle}"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon FontSize="10" Glyph="&#xE73E;" />
                            <TextBlock Text="Accepter" />
                        </StackPanel>
                    </controls:MotionButton>

                    <controls:MotionButton
                        x:Name="FolderButton"
                        Width="24"
                        Padding="0"
                        AutomationProperties.Name="Afficher dans l'Explorateur"
                        Click="OnFolderClick"
                        Style="{StaticResource ChatActionButtonStyle}"
                        ToolTipService.ToolTip="Afficher dans l'Explorateur"
                        Visibility="Collapsed">
                        <FontIcon FontSize="11" Glyph="&#xE838;" />
                    </controls:MotionButton>
                </StackPanel>
            </Grid>

            <!--  ── Plain text ──  -->
            <TextBlock
                x:Name="BodyText"
                FontFamily="Segoe UI Variable Text"
                FontSize="13.5"
                Foreground="{StaticResource NotchPrimaryTextBrush}"
                LineHeight="19"
                MaxLines="12"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!--  ── Web link ──  -->
            <controls:MotionButton
                x:Name="LinkBox"
                Padding="10,8"
                Background="#14FFFFFF"
                Click="OnOpenLinkClick"
                HaloOpacity="0.06"
                HaloRestScale="1"
                HoverScale="0.015"
                PressScale="0.03"
                Style="{StaticResource NotchCardButtonStyle}"
                Visibility="Collapsed">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="34"
                        Height="34"
                        Background="#2422D3EE"
                        CornerRadius="10">
                        <FontIcon
                            FontSize="14"
                            Foreground="#FF22D3EE"
                            Glyph="&#xE71B;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="LinkDomainText"
                            Style="{StaticResource NotchTitleTextStyle}"
                            FontSize="13" />
                        <TextBlock
                            x:Name="LinkUrlText"
                            Style="{StaticResource NotchSubtitleTextStyle}"
                            FontSize="11.5"
                            Foreground="#FF22D3EE" />
                    </StackPanel>
                </Grid>
            </controls:MotionButton>

            <!--  ── Inline image ──  -->
            <Border
                x:Name="ImageBox"
                MaxWidth="360"
                MaxHeight="180"
                HorizontalAlignment="Left"
                Background="#20000000"
                CornerRadius="12"
                PointerPressed="OnImagePointerPressed"
                ToolTipService.ToolTip="Cliquer pour agrandir"
                Visibility="Collapsed">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>

            <!--  ── File or folder ──  -->
            <Grid
                x:Name="FileBox"
                ColumnSpacing="10"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="36"
                    Height="36"
                    Background="#18FFFFFF"
                    CornerRadius="10">
                    <FontIcon
                        x:Name="FileIcon"
                        FontSize="15"
                        Foreground="{StaticResource NotchPrimaryTextBrush}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock
                        x:Name="FileNameText"
                        Style="{StaticResource NotchTitleTextStyle}"
                        FontSize="13" />
                    <TextBlock
                        x:Name="FileDetailText"
                        Style="{StaticResource NotchSubtitleTextStyle}"
                        FontSize="11.5"
                        Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>

