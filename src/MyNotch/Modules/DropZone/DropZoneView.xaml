<UserControl
    x:Class="MyNotch.Modules.DropZone.DropZoneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyNotch.Controls">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="ChatTopFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ChatBottomFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#FF000000" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <!--
        Left, where to drop (they light up while something is dragged over them): the uploads to a link, then the
        Wi-Fi sharing with a phone next to the PC. Right, the uploads, newest first: ongoing ones with their progress,
        then the links still valid; or, while sharing on the Wi-Fi, its QR code. Vertical positions are set from the
        tab bar height in code.
    -->
    <Grid x:Name="LayoutRoot">
        <!--  A soft wash of colour drifting behind everything; it gathers under a file being dragged in.  -->
        <Grid x:Name="AmbienceHost" IsHitTestVisible="False" />

        <!--  Online: dropped files are uploaded and their link copied (the whole notch, closed too, drops here).  -->
        <Grid
            x:Name="DropArea"
            Width="96"
            Height="96"
            Margin="20,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="Transparent"
            ToolTipService.ToolTip="{x:Bind ViewModel.Limits, Mode=OneWay}">
            <Rectangle
                RadiusX="16"
                RadiusY="16"
                Stroke="#4DFFFFFF"
                StrokeDashArray="3,3"
                StrokeThickness="1.5" />
            <!--  Lit while something is dragged over it.  -->
            <Border
                x:Name="DropHighlight"
                Background="#1AFFFFFF"
                BorderBrush="#B3FFFFFF"
                BorderThickness="1.5"
                CornerRadius="16" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="2">
                <Grid
                    x:Name="DropIcon"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center">
                    <FontIcon
                        FontSize="21"
                        Foreground="{StaticResource NotchPrimaryTextBrush}"
                        Glyph="&#xE753;" />
                    <!--  Encrypted (Send): a small padlock on the cloud.  -->
                    <FontIcon
                        Margin="0,0,-10,-4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="10"
                        Foreground="{StaticResource NotchPrimaryTextBrush}"
                        Glyph="&#xE72E;"
                        Visibility="{x:Bind ViewModel.IsEncrypted, Mode=OneWay}" />
                </Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource NotchTitleTextStyle}"
                    FontSize="12.5"
                    Text="En ligne" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource NotchSubtitleTextStyle}"
                    FontSize="11"
                    Text="{x:Bind ViewModel.ShortLimits, Mode=OneWay}"
                    Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </Grid>

        <!--  Wi-Fi sharing: drop files to offer them to the phone, or click to only receive from it.  -->
        <controls:MotionButton
            x:Name="LocalArea"
            Width="96"
            Height="96"
            Margin="124,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            AutomationProperties.Name="Transfert Wi-Fi local"
            Background="Transparent"
            Click="OnLocalClick"
            HaloOpacity="0.06"
            HaloRestScale="1"
            HoverScale="0.03"
            PressScale="0.05"
            Style="{StaticResource NotchCardButtonStyle}"
            ToolTipService.ToolTip="Échanger avec un téléphone sur le même Wi-Fi, sans Internet">
            <Grid>
                <Rectangle
                    RadiusX="16"
                    RadiusY="16"
                    Stroke="#4DFFFFFF"
                    StrokeDashArray="3,3"
                    StrokeThickness="1.5" />
                <!--  While sharing: a steady cyan rim.  -->
                <Border
                    x:Name="LocalOn"
                    Background="#1422D3EE"
                    BorderBrush="#9922D3EE"
                    BorderThickness="1.5"
                    CornerRadius="16" />
                <!--  Lit while something is dragged over it.  -->
                <Border
                    x:Name="LocalHighlight"
                    Background="#1AFFFFFF"
                    BorderBrush="#B3FFFFFF"
                    BorderThickness="1.5"
                    CornerRadius="16" />
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <Grid
                        x:Name="LocalIcon"
                        Margin="0,0,0,6"
                        HorizontalAlignment="Center">
                        <FontIcon
                            FontSize="20"
                            Foreground="{StaticResource NotchPrimaryTextBrush}"
                            Glyph="&#xE8EA;" />
                        <FontIcon
                            Margin="0,0,-13,-5"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            FontSize="11"
                            Foreground="{StaticResource NotchPrimaryTextBrush}"
                            Glyph="&#xE701;" />
                    </Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource NotchTitleTextStyle}"
                        FontSize="12.5"
                        Text="Wi-Fi local" />
                    <TextBlock
                        x:Name="LocalCaption"
                        HorizontalAlignment="Center"
                        Style="{StaticResource NotchSubtitleTextStyle}"
                        FontSize="11"
                        Text="Sans Internet" />
                </StackPanel>
            </Grid>
        </controls:MotionButton>

        <Grid x:Name="UploadsPane">
            <ScrollViewer
                x:Name="Scroller"
                Height="104"
                Margin="236,0,0,0"
                VerticalAlignment="Top"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <StackPanel
                    x:Name="Cards"
                    Padding="0,4,20,4"
                    Orientation="Horizontal"
                    Spacing="8" />
            </ScrollViewer>

            <TextBlock
                x:Name="EmptyHint"
                Width="380"
                Margin="256,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False"
                Style="{StaticResource NotchSubtitleTextStyle}"
                MaxLines="3"
                Text="Glissez des fichiers sur la notch, même fermée : ils partent en ligne et le lien est copié. Sur « Wi-Fi local », ils vont au téléphone d'à côté."
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        </Grid>

        <!--  While sharing on the Wi-Fi: the QR code to scan, where, what, and the way out.  -->
        <Grid
            x:Name="SharePanel"
            Width="404"
            Height="100"
            Margin="236,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            ColumnSpacing="14"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                x:Name="QrTile"
                Width="100"
                Height="100"
                Padding="8"
                Background="White"
                CornerRadius="16">
                <Viewbox x:Name="QrHost" Stretch="Uniform" />
            </Border>

            <Grid Grid.Column="1">
                <StackPanel>
                    <TextBlock
                        x:Name="WhereText"
                        Style="{StaticResource NotchSubtitleTextStyle}"
                        FontSize="11" />
                    <!--  For a phone without a camera: the short address to type, code included.  -->
                    <TextBlock
                        x:Name="TypedText"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource NotchPrimaryTextBrush}"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        Typography.NumeralAlignment="Tabular" />
                    <!--  The IP address too, for phones that do not resolve "mynotch.local".  -->
                    <TextBlock
                        x:Name="AlternateText"
                        Style="{StaticResource NotchSubtitleTextStyle}"
                        FontSize="11"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis"
                        Typography.NumeralAlignment="Tabular"
                        Visibility="Collapsed" />
                    <Grid Margin="0,3,0,0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="SharedIcon"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource NotchPrimaryTextBrush}" />
                        <TextBlock
                            x:Name="SharedText"
                            Grid.Column="1"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NotchPrimaryTextBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            Typography.NumeralAlignment="Tabular" />
                    </Grid>
                </StackPanel>

                <!--  The last file or chat item from the phone, beside the actions (the transfer takes this place while one runs).  -->
                <TextBlock
                    x:Name="ReceivedText"
                    Height="28"
                    Margin="168,0,0,0"
                    Padding="0,6,0,0"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource NotchSubtitleTextStyle}"
                    FontSize="11"
                    Foreground="#FF34C759"
                    MaxLines="1"
                    TextTrimming="CharacterEllipsis" />

                <!--  Files from the phone waiting for an answer, while the notch is open (closed, it asks with a card).  -->
                <Grid
                    x:Name="PendingBar"
                    Height="28"
                    Margin="168,0,0,0"
                    VerticalAlignment="Bottom"
                    ColumnSpacing="5"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PendingText"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Foreground="#FFFFC857"
                        MaxLines="1"
                        TextTrimming="CharacterEllipsis" />
                    <controls:MotionButton
                        Grid.Column="1"
                        Width="26"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Refuser"
                        Background="#33FF453A"
                        Click="OnRefuseIncomingClick"
                        Foreground="#FFFF6B6B"
                        HaloOpacity="0.1"
                        HaloRestScale="1"
                        HoverScale="0.06"
                        PressScale="0.08"
                        Style="{StaticResource NotchPillButtonStyle}"
                        ToolTipService.ToolTip="Refuser">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </controls:MotionButton>
                    <controls:MotionButton
                        Grid.Column="2"
                        Width="26"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Accepter"
                        Background="#FF34C759"
                        Click="OnAcceptIncomingClick"
                        Foreground="Black"
                        HaloOpacity="0.18"
                        HaloRestScale="1"
                        HoverScale="0.06"
                        PressScale="0.08"
                        Style="{StaticResource NotchPillButtonStyle}"
                        ToolTipService.ToolTip="Accepter (dans Téléchargements)">
                        <FontIcon FontSize="11" Glyph="&#xE73E;" />
                    </controls:MotionButton>
                </Grid>

                <!--  While a file crosses the Wi-Fi: its progress and speed, beside the actions.  -->
                <StackPanel
                    x:Name="TransferStatus"
                    Margin="168,0,0,0"
                    VerticalAlignment="Bottom"
                    Height="28"
                    Padding="0,4,0,0"
                    Spacing="6"
                    Visibility="Collapsed">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="TransferIcon"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource NotchPrimaryTextBrush}" />
                        <TextBlock
                            x:Name="TransferText"
                            Grid.Column="1"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NotchPrimaryTextBrush}"
                            MaxLines="1"
                            TextTrimming="CharacterEllipsis"
                            Typography.NumeralAlignment="Tabular" />
                    </Grid>
                    <Grid Height="3">
                        <Border Background="{StaticResource NotchTrackBrush}" CornerRadius="1.5" />
                        <Border
                            x:Name="TransferFill"
                            Background="{StaticResource NotchTrackFillBrush}"
                            CornerRadius="1.5" />
                    </Grid>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal"
                    Spacing="5">
                    <controls:MotionButton
                        MinWidth="0"
                        Padding="12,0"
                        Click="OnStopShareClick"
                        Content="Arrêter"
                        HaloOpacity="0.1"
                        HaloRestScale="1"
                        HoverScale="0.04"
                        PressScale="0.06"
                        Style="{StaticResource NotchPillButtonStyle}" />
                    <controls:MotionButton
                        Width="28"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Coller dans le chat Wi-Fi local"
                        Click="OnPasteShareClick"
                        HaloOpacity="0.1"
                        HaloRestScale="1"
                        HoverScale="0.06"
                        PressScale="0.08"
                        Style="{StaticResource NotchPillButtonStyle}"
                        ToolTipService.ToolTip="Coller depuis le presse-papier (Ctrl+V)">
                        <FontIcon FontSize="12" Glyph="&#xE77F;" />
                    </controls:MotionButton>
                    <controls:MotionButton
                        x:Name="ToggleChatButton"
                        Width="28"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Afficher ou masquer le chat Wi-Fi local"
                        Click="OnToggleChatClick"
                        HaloOpacity="0.1"
                        HaloRestScale="1"
                        HoverScale="0.06"
                        PressScale="0.08"
                        Style="{StaticResource NotchPillButtonStyle}"
                        ToolTipService.ToolTip="Afficher ou masquer la bulle de chat">
                        <FontIcon FontSize="12" Glyph="&#xE8BD;" />
                    </controls:MotionButton>
                    <controls:MotionButton
                        Width="28"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Ouvrir les fichiers reçus"
                        Click="OnOpenReceivedClick"
                        HaloOpacity="0.1"
                        HaloRestScale="1"
                        HoverScale="0.06"
                        PressScale="0.08"
                        Style="{StaticResource NotchPillButtonStyle}"
                        ToolTipService.ToolTip="Ouvrir les fichiers reçus (Téléchargements)">
                        <FontIcon FontSize="12" Glyph="&#xE838;" />
                    </controls:MotionButton>
                </StackPanel>
            </Grid>
        </Grid>

        <!--
            The local Wi-Fi chat sheet: it drops under the notch as a bubble (see NotchContext.ShowBubble) while
            sharing on the local network, so texts, links, pasted images and files can be exchanged with no friction.
        -->
        <Grid x:Name="ChatHolder" Visibility="Collapsed">
            <Grid x:Name="ChatSheet">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ── Header ──  -->
                <Grid
                    x:Name="ChatHeader"
                    Height="38"
                    Margin="22,12,14,0"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="28"
                        Height="28"
                        VerticalAlignment="Center"
                        Background="#2222D3EE"
                        CornerRadius="9">
                        <FontIcon
                            FontSize="13"
                            Foreground="#FF22D3EE"
                            Glyph="&#xE8BD;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            Style="{StaticResource NotchTitleTextStyle}"
                            FontSize="14.5"
                            Text="Chat Wi-Fi local" />
                        <TextBlock
                            x:Name="ChatAddressText"
                            VerticalAlignment="Center"
                            Style="{StaticResource NotchSubtitleTextStyle}"
                            FontSize="12"
                            Foreground="#FF22D3EE"
                            Typography.NumeralAlignment="Tabular" />
                    </StackPanel>

                    <controls:MotionButton
                        Grid.Column="2"
                        MinWidth="0"
                        Padding="12,0"
                        AutomationProperties.Name="Coller depuis le presse-papier"
                        Click="OnPasteShareClick"
                        Style="{StaticResource NotchPillButtonStyle}"
                        ToolTipService.ToolTip="Coller une image, un lien, un texte ou un fichier (Ctrl+V)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE77F;" />
                            <TextBlock Text="Coller" />
                        </StackPanel>
                    </controls:MotionButton>

                    <controls:MotionButton
                        Grid.Column="3"
                        Width="28"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Ouvrir Téléchargements"
                        Click="OnOpenReceivedClick"
                        Style="{StaticResource NotchPillButtonStyle}"
                        ToolTipService.ToolTip="Ouvrir Téléchargements">
                        <FontIcon FontSize="12" Glyph="&#xE838;" />
                    </controls:MotionButton>

                    <controls:MotionButton
                        Grid.Column="4"
                        Width="28"
                        MinWidth="0"
                        Padding="0"
                        AutomationProperties.Name="Réduire la bulle de chat"
                        Click="OnCloseChatClick"
                        Style="{StaticResource NotchPillButtonStyle}"
                        ToolTipService.ToolTip="Réduire la bulle de chat">
                        <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                    </controls:MotionButton>
                </Grid>

                <!--  ── Messages stream ──  -->
                <Grid Grid.Row="1" Margin="6,6,6,4">
                    <ScrollViewer
                        x:Name="ChatScroller"
                        Padding="16,10,16,10"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled"
                        ZoomMode="Disabled">
                        <StackPanel
                            x:Name="ChatMessages"
                            Spacing="8" />
                    </ScrollViewer>

                    <StackPanel
                        x:Name="ChatEmptyHint"
                        MaxWidth="400"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Spacing="6">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="22"
                            Foreground="#4DFFFFFF"
                            Glyph="&#xE8BD;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource NotchTitleTextStyle}"
                            FontSize="13.5"
                            Foreground="#A6FFFFFF"
                            Text="Échangez en direct sur le Wi-Fi" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource NotchSubtitleTextStyle}"
                            FontSize="12"
                            MaxLines="3"
                            Text="Écrivez un message, collez une capture d'écran, un lien ou un fichier avec Ctrl+V, ou glissez des fichiers ici : tout apparaît aussitôt sur mynotch.local."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Rectangle
                        Height="10"
                        VerticalAlignment="Top"
                        Fill="{StaticResource ChatTopFade}"
                        IsHitTestVisible="False" />
                    <Rectangle
                        Height="14"
                        VerticalAlignment="Bottom"
                        Fill="{StaticResource ChatBottomFade}"
                        IsHitTestVisible="False" />
                </Grid>

                <!--  ── Composer bar ──  -->
                <Border
                    Grid.Row="2"
                    Height="40"
                    Margin="20,2,20,16"
                    Padding="14,0,6,0"
                    Background="#14FFFFFF"
                    BorderBrush="#24FFFFFF"
                    BorderThickness="1"
                    CornerRadius="20">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ChatBoxHint"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Text"
                            FontSize="13"
                            Foreground="#66FFFFFF"
                            IsHitTestVisible="False"
                            Text="Écrire un message, un lien, ou Ctrl+V pour coller une image…" />
                        <TextBox
                            x:Name="ChatBox"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Message pour le chat Wi-Fi local"
                            FontSize="13"
                            MaxLength="8000"
                            Style="{StaticResource NotchFieldTextBoxStyle}" />
                        <controls:MotionButton
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            MinWidth="0"
                            Padding="0"
                            AutomationProperties.Name="Envoyer"
                            Background="#FF22D3EE"
                            Click="OnSendChatClick"
                            Foreground="Black"
                            HaloOpacity="0.16"
                            HaloRestScale="1"
                            HoverScale="0.06"
                            PressScale="0.08"
                            Style="{StaticResource NotchPillButtonStyle}"
                            ToolTipService.ToolTip="Envoyer (Entrée)">
                            <FontIcon FontSize="11" Glyph="&#xE724;" />
                        </controls:MotionButton>
                    </Grid>
                </Border>

                <!--  ── In-bubble image preview overlay ──  -->
                <Grid
                    x:Name="ImagePreviewOverlay"
                    Grid.RowSpan="3"
                    Background="#EB060608"
                    CornerRadius="24"
                    PointerPressed="OnClosePreviewPointerPressed"
                    Visibility="Collapsed">
                    <Image
                        x:Name="FullPreviewImage"
                        Margin="18,46,18,18"
                        Stretch="Uniform" />
                    <Grid
                        Height="36"
                        Margin="20,8,14,0"
                        VerticalAlignment="Top"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PreviewTitleText"
                            VerticalAlignment="Center"
                            Style="{StaticResource NotchSubtitleTextStyle}"
                            FontSize="12" />
                        <controls:MotionButton
                            Grid.Column="1"
                            Width="28"
                            MinWidth="0"
                            Padding="0"
                            AutomationProperties.Name="Fermer l'aperçu"
                            Click="OnClosePreviewClick"
                            Style="{StaticResource NotchPillButtonStyle}"
                            ToolTipService.ToolTip="Fermer l'aperçu">
                            <FontIcon FontSize="10" Glyph="&#xE711;" />
                        </controls:MotionButton>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
