<UserControl
    x:Class="MyNotch.Modules.Media.Lyrics.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <!--
        Four recycled lines: the previous one, the one sung, the next one, and a spare one entering or leaving.
        A canvas lets each line keep its natural width: centred when it fits, scrolled when it does not.
    -->
    <Canvas x:Name="Stage">
        <TextBlock x:Name="LineA" Style="{StaticResource NotchLyricTextStyle}" />
        <TextBlock x:Name="LineB" Style="{StaticResource NotchLyricTextStyle}" />
        <TextBlock x:Name="LineC" Style="{StaticResource NotchLyricTextStyle}" />
        <TextBlock x:Name="LineD" Style="{StaticResource NotchLyricTextStyle}" />

        <!--  Karaoke (on the taskbar): each line's bright copy, uncovered from the left as it is sung (see Karaoke).  -->
        <TextBlock x:Name="FillA" Style="{StaticResource NotchLyricTextStyle}" Visibility="Collapsed" />
        <TextBlock x:Name="FillB" Style="{StaticResource NotchLyricTextStyle}" Visibility="Collapsed" />
        <TextBlock x:Name="FillC" Style="{StaticResource NotchLyricTextStyle}" Visibility="Collapsed" />
        <TextBlock x:Name="FillD" Style="{StaticResource NotchLyricTextStyle}" Visibility="Collapsed" />
    </Canvas>
</UserControl>
