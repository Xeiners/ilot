<UserControl
    x:Class="MyNotch.Modules.Media.AudioPopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="340"
    Height="76"
    IsHitTestVisible="False">

    <!--
        "Connected" or "Disconnected", the way AirPods say it, in the pill grown down for the moment: an icon (waves
        spreading from it on connection), the device's name, its status, then its volume or where the sound went.
        All the motion is on the compositor.
    -->
    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="16">
        <Grid
            x:Name="IconStage"
            Width="56"
            Height="56">
            <!--  The waves (composition).  -->
            <Grid x:Name="Ripples" />
            <Ellipse Width="50" Height="50">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#38FFFFFF" />
                        <GradientStop Offset="1" Color="#12FFFFFF" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <FontIcon
                x:Name="Icon"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="24"
                Foreground="White" />
        </Grid>

        <StackPanel
            x:Name="Details"
            VerticalAlignment="Center"
            Spacing="3">
            <TextBlock
                x:Name="NameText"
                MaxWidth="260"
                FontFamily="Segoe UI Variable Display"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Ellipse
                    x:Name="StatusDot"
                    Width="7"
                    Height="7"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Style="{StaticResource NotchSubtitleTextStyle}"
                    FontSize="12" />
            </StackPanel>
            <StackPanel
                Margin="0,2,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    x:Name="FooterIcon"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource NotchSecondaryTextBrush}" />
                <Grid
                    x:Name="VolumeBar"
                    Width="80"
                    Height="4"
                    VerticalAlignment="Center">
                    <Border Background="{StaticResource NotchTrackBrush}" CornerRadius="2" />
                    <Border
                        x:Name="VolumeFill"
                        Background="{StaticResource NotchTrackFillBrush}"
                        CornerRadius="2" />
                </Grid>
                <TextBlock
                    x:Name="FooterText"
                    MaxWidth="190"
                    VerticalAlignment="Center"
                    Style="{StaticResource NotchSubtitleTextStyle}"
                    FontSize="11.5"
                    Typography.NumeralAlignment="Tabular" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
