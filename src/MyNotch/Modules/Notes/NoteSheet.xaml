<UserControl
    x:Class="MyNotch.Modules.Notes.NoteSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyNotch.Controls"
    xmlns:editor="using:MyNotch.Modules.Notes.Editor"
    IsTabStop="True"
    RequestedTheme="Dark"
    UseSystemFocusVisuals="False">

    <UserControl.Resources>
        <!--  The editor is just its text on the sheet: no box, no focus line; the scroll bar shows on demand.  -->
        <Style x:Key="NotesEditorStyle" TargetType="RichEditBox">
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <!--  11 pt, Word's body size.  -->
            <Setter Property="FontSize" Value="14.6667" />
            <Setter Property="SelectionHighlightColor" Value="#FF5A4A26" />
            <Setter Property="SelectionHighlightColorWhenNotFocused" Value="#FF2C2C30" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RichEditBox">
                        <ScrollViewer
                            x:Name="ContentElement"
                            Padding="{TemplateBinding Padding}"
                            AutomationProperties.AccessibilityView="Raw"
                            HorizontalScrollBarVisibility="Disabled"
                            HorizontalScrollMode="Disabled"
                            IsTabStop="False"
                            VerticalScrollBarVisibility="Auto"
                            VerticalScrollMode="Auto"
                            ZoomMode="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  The title: the field is the text itself.  -->
        <Style
            x:Key="NotesTitleStyle"
            BasedOn="{StaticResource NotchFieldTextBoxStyle}"
            TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!--  A pill hugging its icon and label.  -->
        <Style
            x:Key="NotesPillStyle"
            BasedOn="{StaticResource NotchPillButtonStyle}"
            TargetType="controls:MotionButton">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!--  A toolbar button: transparent until chosen; it never takes the focus from the text.  -->
        <Style
            x:Key="NotesToolStyle"
            BasedOn="{StaticResource NotchPillButtonStyle}"
            TargetType="controls:MotionButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
        </Style>

        <Style x:Key="NotesToolSeparatorStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#26FFFFFF" />
        </Style>

        <LinearGradientBrush x:Key="NotesTopFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#FF000000" />
            <GradientStop Offset="1" Color="#00000000" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="NotesBottomFade" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#00000000" />
            <GradientStop Offset="1" Color="#FF000000" />
        </LinearGradientBrush>
    </UserControl.Resources>

    <!--
        A note open: its title and actions, the toolbar the way Word has it, the text, its counts. In the bubble under the
        notch, or in a window of its own (see DetachedWindow).
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── Title and actions ──  -->
        <Grid
            x:Name="Header"
            Height="40"
            Margin="24,14,14,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleHint"
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="22"
                FontWeight="SemiBold"
                Foreground="#40FFFFFF"
                IsHitTestVisible="False"
                Text="Sans titre" />
            <TextBox
                x:Name="TitleBox"
                VerticalAlignment="Center"
                AutomationProperties.Name="Titre de la note"
                MaxLength="200"
                Style="{StaticResource NotesTitleStyle}" />

            <!--  Its actions; in a window, the window's own among them (see AddWindowTools).  -->
            <StackPanel
                x:Name="Actions"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <controls:MotionButton
                    x:Name="CopyButton"
                    AutomationProperties.Name="Copier dans le presse-papier"
                    Click="OnCopyClick"
                    Style="{StaticResource NotesPillStyle}"
                    ToolTipService.ToolTip="Copier la note, mise en forme comprise (pour Word…)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            x:Name="CopyIcon"
                            FontSize="12"
                            Glyph="&#xE8C8;" />
                        <TextBlock x:Name="CopyText" Text="Copier" />
                    </StackPanel>
                </controls:MotionButton>

                <!--  Deleting asks once: the pill turns red, a second click confirms.  -->
                <controls:MotionButton
                    x:Name="DeleteButton"
                    AutomationProperties.Name="Supprimer la note"
                    Click="OnDeleteClick"
                    Style="{StaticResource NotesPillStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                        <TextBlock x:Name="DeleteText" Text="Supprimer" />
                    </StackPanel>
                </controls:MotionButton>

                <!--  The note out of the notch into a window of its own, or back.  -->
                <controls:MotionButton
                    x:Name="MoveButton"
                    Width="28"
                    MinWidth="0"
                    Padding="0"
                    Click="OnMoveClick"
                    Style="{StaticResource NotchPillButtonStyle}">
                    <FontIcon
                        x:Name="MoveIcon"
                        FontSize="11"
                        Glyph="&#xE8A7;" />
                </controls:MotionButton>

                <controls:MotionButton
                    x:Name="CloseButton"
                    Width="28"
                    MinWidth="0"
                    Padding="0"
                    AutomationProperties.Name="Fermer la note"
                    Click="OnCloseClick"
                    Style="{StaticResource NotchPillButtonStyle}"
                    ToolTipService.ToolTip="Fermer la note">
                    <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                </controls:MotionButton>
            </StackPanel>
        </Grid>

        <!--  ── Formatting, the way Word has it ──  -->
        <Border
            x:Name="Toolbar"
            Grid.Row="1"
            Margin="16,10,16,0"
            Padding="4"
            HorizontalAlignment="Left"
            Background="#0DFFFFFF"
            BorderBrush="#12FFFFFF"
            BorderThickness="1"
            CornerRadius="19">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <controls:MotionButton
                    x:Name="BodyStyleButton"
                    Click="OnStyleClick"
                    Content="Texte"
                    Style="{StaticResource NotesToolStyle}"
                    Tag="Body"
                    ToolTipService.ToolTip="Texte normal" />
                <controls:MotionButton
                    x:Name="TitleStyleButton"
                    Click="OnStyleClick"
                    Content="Titre"
                    FontWeight="SemiBold"
                    Style="{StaticResource NotesToolStyle}"
                    Tag="Title"
                    ToolTipService.ToolTip="Titre (# puis espace)" />
                <controls:MotionButton
                    x:Name="HeadingStyleButton"
                    Click="OnStyleClick"
                    Content="Titre 2"
                    FontWeight="SemiBold"
                    Style="{StaticResource NotesToolStyle}"
                    Tag="Heading"
                    ToolTipService.ToolTip="Titre 2 (## puis espace)" />
                <controls:MotionButton
                    x:Name="SubheadingStyleButton"
                    Click="OnStyleClick"
                    Content="Titre 3"
                    FontWeight="SemiBold"
                    Style="{StaticResource NotesToolStyle}"
                    Tag="Subheading"
                    ToolTipService.ToolTip="Titre 3 (### puis espace)" />

                <Rectangle Style="{StaticResource NotesToolSeparatorStyle}" />

                <controls:MotionButton
                    AutomationProperties.Name="Réduire la taille"
                    Click="OnSizeDownClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Réduire la taille">
                    <FontIcon FontSize="13" Glyph="&#xE8E7;" />
                </controls:MotionButton>
                <TextBlock
                    x:Name="SizeText"
                    Width="32"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12.5"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource NotchPrimaryTextBrush}"
                    Text="11"
                    TextAlignment="Center"
                    ToolTipService.ToolTip="Taille (points)"
                    Typography.NumeralAlignment="Tabular" />
                <controls:MotionButton
                    AutomationProperties.Name="Augmenter la taille"
                    Click="OnSizeUpClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Augmenter la taille">
                    <FontIcon FontSize="13" Glyph="&#xE8E8;" />
                </controls:MotionButton>

                <Rectangle Style="{StaticResource NotesToolSeparatorStyle}" />

                <controls:MotionButton
                    x:Name="BoldButton"
                    AutomationProperties.Name="Gras"
                    Click="OnBoldClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Gras (Ctrl+B)">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="G" />
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="ItalicButton"
                    AutomationProperties.Name="Italique"
                    Click="OnItalicClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Italique (Ctrl+I)">
                    <TextBlock
                        FontFamily="Georgia"
                        FontSize="15"
                        FontStyle="Italic"
                        Text="I" />
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="UnderlineButton"
                    AutomationProperties.Name="Souligné"
                    Click="OnUnderlineClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Souligné (Ctrl+U)">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="14"
                        Text="S"
                        TextDecorations="Underline" />
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="StrikeButton"
                    AutomationProperties.Name="Barré"
                    Click="OnStrikeClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Barré">
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="14"
                        Text="abc"
                        TextDecorations="Strikethrough" />
                </controls:MotionButton>

                <Rectangle Style="{StaticResource NotesToolSeparatorStyle}" />

                <controls:MotionButton
                    x:Name="BulletsButton"
                    AutomationProperties.Name="Liste à puces"
                    Click="OnBulletsClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Liste à puces (- puis espace)">
                    <FontIcon FontSize="14" Glyph="&#xE8FD;" />
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="NumbersButton"
                    AutomationProperties.Name="Liste numérotée"
                    Click="OnNumbersClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Liste numérotée (1. puis espace)">
                    <StackPanel Spacing="-3">
                        <TextBlock
                            FontFamily="Segoe UI Variable Text"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Text="1 ―" />
                        <TextBlock
                            FontFamily="Segoe UI Variable Text"
                            FontSize="9"
                            FontWeight="SemiBold"
                            Text="2 ―" />
                    </StackPanel>
                </controls:MotionButton>
                <controls:MotionButton
                    x:Name="ChecksButton"
                    AutomationProperties.Name="Liste de tâches"
                    Click="OnChecksClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Liste de tâches ([] puis espace ; Ctrl+Entrée coche)">
                    <FontIcon FontSize="14" Glyph="&#xE73A;" />
                </controls:MotionButton>

                <Rectangle Style="{StaticResource NotesToolSeparatorStyle}" />

                <controls:MotionButton
                    AutomationProperties.Name="Annuler"
                    Click="OnUndoClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Annuler (Ctrl+Z)">
                    <FontIcon FontSize="13" Glyph="&#xE7A7;" />
                </controls:MotionButton>
                <controls:MotionButton
                    AutomationProperties.Name="Rétablir"
                    Click="OnRedoClick"
                    Padding="0"
                    Style="{StaticResource NotesToolStyle}"
                    ToolTipService.ToolTip="Rétablir (Ctrl+Y)">
                    <FontIcon FontSize="13" Glyph="&#xE7A6;" />
                </controls:MotionButton>
            </StackPanel>
        </Border>

        <!--  ── The text ──  -->
        <Grid
            x:Name="EditorArea"
            Grid.Row="2"
            Margin="6,8,6,0">
            <editor:RichNoteEditor
                x:Name="Editor"
                Padding="18,8,18,18"
                AutomationProperties.Name="Texte de la note"
                Style="{StaticResource NotesEditorStyle}" />
            <!--  The button over the box under the mouse: the hand, and a click ticks it (see RichNoteEditor).  -->
            <Canvas x:Name="BoxLayer" />
            <TextBlock
                x:Name="EditorHint"
                Margin="18,8,18,0"
                VerticalAlignment="Top"
                FontFamily="Segoe UI Variable Text"
                FontSize="14.6667"
                Foreground="#4DFFFFFF"
                IsHitTestVisible="False"
                TextWrapping="Wrap">
                <Run Text="Écrivez…  " /><Run Foreground="#33FFFFFF" Text="« - » liste, « 1. » numéros, « [] » tâches, « # » titre, puis espace" />
            </TextBlock>

            <!--  The text melts into the sheet at both ends as it scrolls.  -->
            <Rectangle
                Height="10"
                VerticalAlignment="Top"
                Fill="{StaticResource NotesTopFade}"
                IsHitTestVisible="False" />
            <Rectangle
                Height="20"
                VerticalAlignment="Bottom"
                Fill="{StaticResource NotesBottomFade}"
                IsHitTestVisible="False" />
        </Grid>

        <!--  ── Counts ──  -->
        <StackPanel
            Grid.Row="3"
            Height="24"
            Margin="40,2,40,12"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                VerticalAlignment="Center"
                FontFamily="Segoe UI Variable Text"
                FontSize="12"
                Foreground="{StaticResource NotchSecondaryTextBrush}"
                x:Name="CountText"
                Typography.NumeralAlignment="Tabular" />
            <StackPanel
                x:Name="SavedBadge"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <FontIcon
                    x:Name="SavedIcon"
                    FontSize="10"
                    Foreground="{StaticResource NotchSecondaryTextBrush}"
                    Glyph="&#xE73E;" />
                <TextBlock
                    x:Name="SavedText"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12"
                    Foreground="{StaticResource NotchSecondaryTextBrush}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
