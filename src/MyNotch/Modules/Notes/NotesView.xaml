<UserControl
    x:Class="MyNotch.Modules.Notes.NotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyNotch.Controls">

    <!--
        The notes as a row of cards, like the clipboard's; a click opens one in a sheet below (a NoteSheet, in the notch's
        bubble). Vertical positions are set from the tab bar height in code.
    -->
    <Grid x:Name="LayoutRoot">
        <ScrollViewer
            x:Name="Scroller"
            Height="104"
            VerticalAlignment="Top"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ZoomMode="Disabled">
            <StackPanel
                x:Name="Cards"
                Padding="20,4,20,4"
                Orientation="Horizontal"
                Spacing="8">
                <controls:MotionButton
                    x:Name="NewCard"
                    Width="96"
                    Height="96"
                    AutomationProperties.Name="Nouvelle note"
                    Background="Transparent"
                    Click="OnNewClick"
                    HaloOpacity="0.06"
                    HaloRestScale="1"
                    HoverScale="0.04"
                    PressScale="0.06"
                    Style="{StaticResource NotchCardButtonStyle}">
                    <Grid>
                        <Rectangle
                            RadiusX="16"
                            RadiusY="16"
                            Stroke="#40FFFFFF"
                            StrokeDashArray="3,3"
                            StrokeThickness="1.5" />
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="7">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                            <TextBlock
                                FontFamily="Segoe UI Variable Text"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Text="Nouvelle note" />
                        </StackPanel>
                    </Grid>
                </controls:MotionButton>
            </StackPanel>
        </ScrollViewer>

        <!--  No note yet, or none matching the search.  -->
        <TextBlock
            x:Name="RowHint"
            Margin="136,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            Style="{StaticResource NotchSubtitleTextStyle}"
            Visibility="Collapsed" />

        <!--  Search, at the right end of the tab bar row: in the titles and the texts.  -->
        <controls:NotchSearchBox
            x:Name="Search"
            Margin="0,1,12,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Label="Rechercher une note" />
    </Grid>
</UserControl>
