<UserControl
    x:Class="MyNotch.Modules.Assistant.AssistantPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mascot="using:MyNotch.Mascot">

    <!--  The drop under the bar, as big as it is (it may be resized): the notch's black, the conversation on the left (the  -->
    <!--  questions on the right of it, the answers on the left, formatted; no scroll bar, its ends fading out), and the  -->
    <!--  mascot, large, on the right, in its own glow (see AssistantGlass). Before the first question, a greeting.  -->
    <Grid>
        <Border x:Name="Backdrop" IsHitTestVisible="False" />

        <Grid Padding="26,18,0,12" ColumnSpacing="6" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="150" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  The conversations kept, in place of this one (see ShowHistory): built in code.  -->
            <Grid x:Name="HistoryHost" Visibility="Collapsed" />

            <StackPanel
                x:Name="Greeting"
                VerticalAlignment="Center"
                Spacing="6">
                <TextBlock
                    FontFamily="Segoe UI Variable Display"
                    FontSize="23"
                    FontWeight="SemiBold"
                    Text="Bonjour, je vous écoute.">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Offset="0" Color="#FFFFFFFF" />
                            <GradientStop Offset="0.6" Color="#FFE9ECF2" />
                            <GradientStop Offset="1" Color="#FFC4CAD6" />
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                </TextBlock>
            </StackPanel>

            <Grid x:Name="Conversation" Visibility="Collapsed">
                <ScrollViewer
                    x:Name="Scroller"
                    HorizontalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <StackPanel
                        x:Name="Messages"
                        Padding="0,4,4,4"
                        Spacing="12" />
                </ScrollViewer>
                <!--  The conversation's ends fade into the black when there is more past them (see UpdateFades), and fade out  -->
                <!--  themselves towards the mascot's side: no edge over its glow (drawn on the compositor, see CreateFade).  -->
                <Border
                    x:Name="TopFade"
                    Height="28"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Opacity="0" />
                <Border
                    x:Name="BottomFade"
                    Height="28"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False"
                    Opacity="0" />
            </Grid>

            <Grid
                x:Name="Footer"
                Grid.Row="1"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="Credit"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="11"
                    Foreground="#66FFFFFF"
                    Text="Gemini, de Google : vos questions lui sont envoyées."
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6">
                    <!--  The conversations kept (see ShowHistory).  -->
                    <Button
                        x:Name="HistoryButton"
                        Padding="10,4"
                        Background="#1AFFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="11" Glyph="&#xE81C;" />
                            <TextBlock FontSize="12" Text="Historique" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="NewButton"
                        Padding="10,4"
                        Background="#1AFFFFFF"
                        BorderBrush="#24FFFFFF"
                        BorderThickness="1"
                        CornerRadius="9">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="11" Glyph="&#xE710;" />
                            <TextBlock FontSize="12" Text="Nouvelle conversation" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  The mascot's stage, on the right, in the middle of the drop: the mascot, larger before the first question, and  -->
        <!--  under it a pill to talk with it aloud (a click on either: see TalkRequested). Laid out where it rests; the  -->
        <!--  compositor carries it with the drop as it springs, and floats it while it thinks (AssistantGlass.StageTranslation).  -->
        <Grid
            x:Name="Stage"
            Width="150"
            Height="176"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="Transparent">
            <mascot:MascotView
                x:Name="Face"
                Width="108"
                Height="108"
                Margin="0,14,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False" />
            <Border
                x:Name="TalkPill"
                Height="24"
                Margin="0,0,0,10"
                Padding="11,0,12,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#1AFFFFFF"
                CornerRadius="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        x:Name="TalkPillGlyph"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="#E6FFFFFF"
                        Glyph="&#xE720;" />
                    <TextBlock
                        x:Name="TalkPillText"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Text"
                        FontSize="11.5"
                        Foreground="#E6FFFFFF"
                        Text="Parler" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
