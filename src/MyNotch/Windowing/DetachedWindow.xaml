<Window
    x:Class="MyNotch.Windowing.DetachedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MyNotch.Controls">

    <!--
        A sheet detached from the notch: drawn like the bubble (black, its corners rounded the same, a hairline edge), on a
        see-through window. Its handle at the top moves it, its bottom corners resize it (see DetachedWindow).
    -->
    <Grid x:Name="Root" RequestedTheme="Dark">
        <Border
            x:Name="Frame"
            Background="Black"
            CornerRadius="32">
            <Grid>
                <ContentControl
                    x:Name="Holder"
                    Margin="0,4,0,0"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    IsTabStop="False" />
                <controls:MoveHandle x:Name="Handle" />
                <controls:ResizeGrip x:Name="LeftGrip" IsLeft="True" />
                <controls:ResizeGrip x:Name="RightGrip" />
            </Grid>
        </Border>
        <Border
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            CornerRadius="32"
            IsHitTestVisible="False" />
    </Grid>
</Window>
