<Window
    x:Class="MyNotch.Welcome.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mascot="using:MyNotch.Mascot">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Custom title bar over the Mica backdrop, as the settings'.  -->
        <Grid x:Name="TitleBar" Padding="16,0,140,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Border
                    Width="22"
                    Height="14"
                    VerticalAlignment="Center"
                    Background="Black"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="0,0,7,7" />
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Bienvenue dans MyNotch" />
            </StackPanel>
        </Grid>

        <!--  The mascot greets: it wears the colour chosen, live.  -->
        <mascot:MascotView
            x:Name="Buddy"
            Grid.Row="1"
            Width="84"
            Height="84"
            Margin="0,4,0,0"
            HorizontalAlignment="Center" />

        <!--  The steps, one shown at a time (see Go).  -->
        <ScrollViewer Grid.Row="2" Padding="0,8,0,0">
            <Grid MaxWidth="540" Padding="32,4,32,24">

                <!--  1. Welcome, and the language.  -->
                <StackPanel x:Name="WelcomeStep" Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Bienvenue dans MyNotch" />
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="La notch qui vit en haut de votre écran, tout à portée de souris."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE8D6;" />
                                <TextBlock VerticalAlignment="Center" Text="Votre musique et ses paroles, dans la notch ou la barre des tâches" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE77F;" />
                                <TextBlock VerticalAlignment="Center" Text="Vos dernières copies, à recoller en un clic" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE898;" />
                                <TextBlock VerticalAlignment="Center" Text="Vos fichiers partagés d'un simple glisser" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE7BE;" />
                                <TextBlock VerticalAlignment="Center" Text="Vos cours en fiches, flashcards et cartes mentales, rangés par matière" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE916;" />
                                <TextBlock VerticalAlignment="Center" Text="Des notes et un Pomodoro toujours sous la main" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE99A;" />
                                <TextBlock VerticalAlignment="Center" Text="Un assistant IA, par écrit ou à voix haute" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xF2B7;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Langue" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Cette fenêtre la prend tout de suite, la notch au prochain lancement."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="LanguageBox"
                                Grid.Column="2"
                                MinWidth="170"
                                VerticalAlignment="Center"
                                SelectionChanged="OnLanguageChanged">
                                <x:String>Celle de Windows</x:String>
                                <x:String>Français</x:String>
                                <x:String>English</x:String>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  2. The mascot: its colour (it is always there).  -->
                <StackPanel x:Name="MascotStep" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Notch, votre mascotte" />
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Elle vit dans la notch : elle danse sur votre musique, réagit à vos copies et vous répond quand vous cliquez dessus."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Sa couleur" />
                            <VariableSizedWrapGrid
                                x:Name="MascotColors"
                                ItemHeight="38"
                                ItemWidth="38"
                                Orientation="Horizontal" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  3. The notch: as it rests, full screen, with Windows.  -->
                <StackPanel x:Name="NotchStep" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Votre notch" />
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choisissez comment elle se tient en haut de l'écran."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <RadioButtons SelectedIndex="{x:Bind NotchModeIndex, Mode=TwoWay}">
                            <RadioButton>
                                <StackPanel Margin="0,0,0,6">
                                    <TextBlock Text="Normale" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Elle montre ce qui se passe (la musique, un minuteur, la mascotte) et se fait discrète quand rien ne bouge."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton>
                                <StackPanel>
                                    <TextBlock Text="Minimisée" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="Juste une fine poignée : survolez-la pour l'ouvrir."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </RadioButtons>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE7C9;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Rester ouverte après un clic" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Ouverte au survol, la notch se referme quand la souris s'en va. Après un clic dedans, elle reste ouverte jusqu'à un clic ailleurs."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                IsOn="{x:Bind Settings.StayOpenAfterClick, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE7B3;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Se cacher au repos" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Quelques secondes sans son : elle laisse le lecteur et ne garde que la mascotte, dans son nid. Le délai se règle dans les paramètres."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                IsOn="{x:Bind Settings.HideWhenIdle, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE740;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Masquer en plein écran" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Elle s'efface pendant un jeu, une vidéo ou une présentation."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                IsOn="{x:Bind Settings.HideInFullscreen, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE7E8;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Lancer avec Windows" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="MyNotch démarre avec votre session."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="StartupToggle"
                                Grid.Column="2"
                                MinWidth="0"
                                OffContent=""
                                OnContent=""
                                Toggled="OnStartupToggled" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  4. The music: its lyrics, where the sung line goes (the notch or the taskbar), the player off the notch.  -->
                <StackPanel x:Name="MusicStep" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Votre musique" />
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Ce qui joue sur l'ordinateur (Spotify, un navigateur…) s'affiche dans la notch, avec ses paroles quand le morceau en a."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE8BD;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Afficher les paroles" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Quand le morceau en a : dans la notch ouverte, et la ligne chantée sur la notch fermée ou dans la barre des tâches."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                IsOn="{x:Bind Settings.ShowLyrics, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <FontIcon FontSize="18" Glyph="&#xE7F4;" />
                                <TextBlock VerticalAlignment="Center" Text="Ligne chantée" />
                            </StackPanel>
                            <RadioButtons IsEnabled="{x:Bind Settings.ShowLyrics, Mode=OneWay}" SelectedIndex="{x:Bind LyricsPlaceIndex, Mode=TwoWay}">
                                <RadioButton>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Dans la notch" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="Sur la notch fermée, entre la pochette et le visualiseur."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="Dans la barre des tâches" />
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="À droite, contre les icônes, avec la pochette ; tirez son bord gauche pour régler sa largeur."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </RadioButton>
                            </RadioButtons>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE8D6;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Retirer le lecteur de la notch fermée" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Tant que la barre des tâches montre le morceau, la notch fermée garde son état neutre, la mascotte seule. En pause, « Se cacher au repos » décide ; un morceau sans paroles revient sur la notch."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                IsEnabled="{x:Bind OnTaskbar(Settings.LyricsPlace), Mode=OneWay}"
                                IsOn="{x:Bind Settings.HidePlayerInNotch, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!--  5. The shortcuts, from anywhere.  -->
                <StackPanel x:Name="ShortcutsStep" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Vos raccourcis" />
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Depuis n'importe quelle application. Ils se mettent en pause quand un jeu ou une vidéo est en plein écran."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE721;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="Chercher" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Une appli, un fichier, un calcul, une page web."
                                    TextWrapping="Wrap" />
                                <StackPanel x:Name="SearchKeys" Orientation="Horizontal" Spacing="4" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                IsOn="{x:Bind Settings.SearchShortcutOn, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE77F;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="Presse-papier" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Vos dernières copies, à la place de celui de Windows."
                                    TextWrapping="Wrap" />
                                <StackPanel x:Name="ClipboardKeys" Orientation="Horizontal" Spacing="4" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                IsOn="{x:Bind Settings.ReplaceWindowsClipboard, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontSize="18" Glyph="&#xE99A;" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock Text="Assistant" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="Comme un clic sur la mascotte."
                                    TextWrapping="Wrap" />
                                <StackPanel x:Name="AssistantKeys" Orientation="Horizontal" Spacing="4" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                IsOn="{x:Bind Settings.AssistantShortcutOn, Mode=TwoWay}"
                                OffContent=""
                                OnContent="" />
                        </Grid>
                    </Border>
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Vous pourrez choisir d'autres touches dans les paramètres."
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  6. The assistant: what it does, its key (optional).  -->
                <StackPanel x:Name="AssistantStep" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="L'assistant IA" />
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Cliquez sur la mascotte et posez-lui une question, par écrit ou à voix haute. Il fonctionne avec Google Gemini, qui demande une clé gratuite."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="1. Ouvrez Google AI Studio, connectez-vous et créez une clé."
                                    TextWrapping="Wrap" />
                                <HyperlinkButton
                                    x:Name="AiStudioLink"
                                    Grid.Column="1"
                                    Content="Ouvrir AI Studio" />
                            </Grid>
                            <TextBlock Text="2. Copiez-la, puis collez-la ici :" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="ApiKeyBox" PlaceholderText="Collez votre clé API" />
                                <Button
                                    x:Name="SaveKeyButton"
                                    Grid.Column="1"
                                    Click="OnSaveKeyClick"
                                    Content="Enregistrer"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <TextBlock
                                x:Name="ApiKeyStatus"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Facultatif : vous pourrez l'ajouter plus tard dans Paramètres, Assistant. La clé reste sur cet ordinateur, dans le coffre de Windows."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!--  7. Ready: the tour of the notch, or later.  -->
                <StackPanel x:Name="ReadyStep" Spacing="4" Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Tout est prêt" />
                    <TextBlock
                        Margin="0,0,0,16"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Une petite visite de la notch pour voir ce qui se clique ? Ça prend une minute."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource SettingsCardStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE8A9;" />
                                <TextBlock VerticalAlignment="Center" Text="Les onglets et ce qu'ils font" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE7C9;" />
                                <TextBlock VerticalAlignment="Center" Text="Ce qui se clique, se glisse et se fait au clic droit" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE7BE;" />
                                <TextBlock VerticalAlignment="Center" Text="Vos révisions : les sections, les cartes à revoir, les cartes mentales" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE8D6;" />
                                <TextBlock VerticalAlignment="Center" Text="Les paroles, dans la notch ou la barre des tâches" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon FontSize="18" Glyph="&#xE99A;" />
                                <TextBlock VerticalAlignment="Center" Text="Comment parler à l'assistant IA" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Vous pourrez la refaire depuis les paramètres."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  Where one is, and the way on.  -->
        <Grid
            Grid.Row="3"
            Padding="24,14"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <HyperlinkButton
                x:Name="SkipButton"
                Click="OnSkipClick"
                Content="Passer" />
            <StackPanel
                x:Name="Dots"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="6" />
            <Button
                x:Name="BackButton"
                Grid.Column="2"
                Click="OnBackClick"
                Content="Précédent" />
            <Button
                x:Name="NextButton"
                Grid.Column="3"
                MinWidth="120"
                Click="OnNextClick"
                Content="Suivant"
                Style="{StaticResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Window>
